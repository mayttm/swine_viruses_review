installed <- rownames(installed.packages())
if (length(setdiff(packages, installed)) > 0) {
  install.packages(setdiff(packages, installed)) }

dataset_names <- ls(pattern = "^df_")

library(meta)
library(dplyr)
library(stringr)

for (dataset_name in dataset_names) {
  
  data <- get(dataset_name)
  
  # Filter studies with at least 30 samples
  data <- data %>%
    filter(sample_size >= 30)
  
  # Exclude studies using virus isolation
  data <- data %>%
    filter(diag_test != "Virus_isolation")
  
  # Skip datasets with fewer than 5 studies
  if (length(unique(data$pub_ID)) < 5) {
    message(paste0("⏩ Skipping ", dataset_name, ": fewer than 5 pub_IDs after filtering."))
    next
  }
  
  # Sort by sampling year
  data <- data %>%
    arrange(sampling_year)
  
  # Create study label (pig_type removed)
  data <- data %>%
    mutate(label = paste0(pub_ID))
  
  # Meta-analysis object using {meta}
  meta_res <- metaprop(
    event = positive_sample,
    n = sample_size,
    studlab = label,
    data = data,
    sm = "PLOGIT",         # Logit transformation for prevalence
    method = "Inverse",    # Inverse variance weighting
    comb.fixed = TRUE,     # Show fixed-effect pooled prevalence
    comb.random = TRUE,    # Show random-effects pooled prevalence
    method.tau = "REML",   # REML estimator
    hakn = TRUE,           # Hartung-Knapp CI adjustment
    prediction = TRUE      # Add prediction interval
  )
  
  # Clean title
  plot_title <- dataset_name %>%
    str_replace("^df_", "") %>%
    str_replace_all("_", " ")
  
  # Zebra-style shading by pub_ID
  shade_groups <- as.numeric(factor(data$pub_ID)) %% 2 != 0
  
  # Dynamic font & margin scaling
  n_studies <- nrow(data)
  cex_value <- min(0.9, 800 / n_studies + 20)     
  mar_bottom <- max(2, 2 + n_studies * 0.1) # Bottom margin if many studies
  mar_left <- max(1, 1 + n_studies * 0.05) # Extra margin for added columns
  
  png_width <- 4000                           
  png_height <- max(2800, n_studies * 100) 
  
  png(
    filename = paste0("figures/forest/forest_", dataset_name, ".png"),
    width = png_width,
    height = png_height,
    res = 300
  )
  
  par(mar = c(mar_bottom, mar_left, 6, 10))  # bottom, left, top, right
  
  forest(
    meta_res,
    sortvar = data$sampling_year,
    smlab = "",
    
    leftcols = c("studlab", "diag_test_details", "sampling_year", "n"),
    leftlabs = c("Study", "Diagnostic Test", "Sampling Year", "Sample Size"),
    
    rightcols = c("effect", "ci", "w.random"),
    rightlabs = c("Prevalence", "95% CI", "Weight"),
    
    # Model settings
    comb.fixed = TRUE,
    comb.random = TRUE,
    text.fixed = "Fixed-effect Pooled Prevalence",
    text.random = "Random-effects Pooled Prevalence",
    prediction = TRUE,
    col.predict = "darkblue",
    col.diamond.fixed = "darkorange",
    col.diamond.random = "red",
    col.diamond.lines = "black",
    
    # Zebra shading
    shade = shade_groups,
    print.tau2 = TRUE,
    print.I2 = TRUE,
    xlab = "Pooled Prevalence",
    xlim = c(0, 1),
    just = "center",
    cex = cex_value,
    cex.lab = cex_value, 
    colgap.forest.left = "2cm",
    spacing = 1.15
  )
  
  dev.off()
  
  message(paste0("✅ Forest plot created for ", dataset_name, " (", n_studies, " studies)"))
}

##---------------------- combined pooled prevalence--------------------------###

library(metafor)
library(meta)
library(dplyr)
library(tidyr)
library(stringr)

pooled_results <- list()

dataset_names <- ls(pattern = "^df_")

for (dataset_name in dataset_names) {
  data <- get(dataset_name)
  
  # Harmonize column names
  if (!"sample_size" %in% names(data)) {
    if ("n" %in% names(data)) data <- dplyr::rename(data, sample_size = n)
    else if ("N" %in% names(data)) data <- dplyr::rename(data, sample_size = N)
  }
  
  # Check required columns
  required <- c("sample_size","positive_sample","diag_test","pub_ID","sampling_year")
  missing <- setdiff(required, names(data))
  if (length(missing)) {
    message(paste0("⏩ Skipping ", dataset_name, ": missing columns: ", paste(missing, collapse=", ")))
    next
  }
  
  # Filter studies
  data <- data %>%
    filter(sample_size >= 30,
           diag_test != "Virus_isolation")
  
  # Skip datasets with fewer than 5 studies
  if (dplyr::n_distinct(data$pub_ID) < 5) {
    message(paste0("⏩ Skipping ", dataset_name, ": fewer than 5 pub_IDs after filtering."))
    next
  }
  
  # Sort and create study labels
  data <- data %>%
    arrange(sampling_year) %>%
    mutate(label = make.unique(as.character(pub_ID)))
  
  # Meta-analysis
  meta_res <- tryCatch(
    {
      metaprop(
        event = positive_sample,
        n = sample_size,
        studlab = label,
        data = data,
        sm = "PLOGIT",
        method = "Inverse",
        comb.fixed = TRUE,
        comb.random = TRUE,
        method.tau = "REML",
        hakn = TRUE,
        prediction = TRUE
      )
    },
    error = function(e) {
      message(paste0("⚠ Meta-analysis failed for ", dataset_name, ": ", e$message))
      return(NULL)
    }
  )
  
  if (is.null(meta_res)) next
  
  # Perform Begg's rank correlation test (publication bias)
  begg_pval <- tryCatch({
    begg_test <- metabias(meta_res, method = "rank")
    as.numeric(begg_test$p.value)
  }, error = function(e) {
    message(paste0("⚠ Begg's test failed for ", dataset_name))
    return(NA)
  })
  
  egger_pval <- tryCatch({
    egger_test <- metabias(meta_res, method = "linreg")
    as.numeric(egger_test$p.value)
  }, error = function(e) {
    message(paste0("⚠ Egger's test failed for ", dataset_name))
    return(NA)
  })
  
  # Summaries
  num_studies <- dplyr::n_distinct(data$pub_ID)
  total_sample_size <- sum(data$sample_size, na.rm = TRUE)
  
  # Back-transform pooled estimates and intervals
  prev_fixed   <- meta::backtransf(meta_res$TE.fixed,        sm = meta_res$sm)
  ciF_lb       <- meta::backtransf(meta_res$lower.fixed,     sm = meta_res$sm)
  ciF_ub       <- meta::backtransf(meta_res$upper.fixed,     sm = meta_res$sm)
  prev_random  <- meta::backtransf(meta_res$TE.random,       sm = meta_res$sm)
  ciR_lb       <- meta::backtransf(meta_res$lower.random,    sm = meta_res$sm)
  ciR_ub       <- meta::backtransf(meta_res$upper.random,    sm = meta_res$sm)
  pi_lb        <- meta::backtransf(meta_res$lower.predict,   sm = meta_res$sm)
  pi_ub        <- meta::backtransf(meta_res$upper.predict,   sm = meta_res$sm)
  
  # Save results
  pooled_results[[dataset_name]] <- data.frame(
    Dataset            = dataset_name,
    NumStudies         = num_studies,
    TotalSampleSize    = total_sample_size,
    PooledPrev_Fixed   = prev_fixed,
    CI_Fixed_LB        = ciF_lb,
    CI_Fixed_UB        = ciF_ub,
    PooledPrev_Random  = prev_random,
    CI_Random_LB       = ciR_lb,
    CI_Random_UB       = ciR_ub,
    PI_Random_LB       = pi_lb,
    PI_Random_UB       = pi_ub,
    I2                 = meta_res$I2,
    Tau2               = meta_res$tau2,
    Begg_Pval          = begg_pval,
    Egger_Pval         = egger_pval,
    stringsAsFactors   = FALSE
  )
}

# Combine all pooled results into one dataframe
pooled_results_df <- do.call(rbind, pooled_results)

pooled_results_df$CleanName  <- str_replace(pooled_results_df$Dataset, "^df_", "")
pooled_results_df$Diagnostic <- str_extract(pooled_results_df$CleanName, "^[^_]+")
pooled_results_df <- pooled_results_df %>%
  mutate(
    Virus = case_when(
      CleanName == "serological_IAV_H1N1" ~ "IAV_H1N1",
      TRUE ~ str_extract(CleanName, "[^_]+$")
    )
  )
pooled_results_df$NumStudies <- pooled_results_df$NumStudies
pooled_results_df$NumSamples <- pooled_results_df$TotalSampleSize

write.csv(pooled_results_df, file = "pooled_prevalence_summary_PR.csv", row.names = FALSE)

studies_fmt <- pooled_results_df$NumStudies
samples_fmt <- format(pooled_results_df$NumSamples, big.mark=",")

# Forest plot with zebra shading
png("figures/forest_pooled_prevalence_PR.png", width = 4000, height = 2800, res = 300)

# add more space on the right for the annotation column
par(mar = c(4, 6, 4, 4))

x_est  <- 1.25                   # "Estimate [95% CI]" column
x_i2   <- 1.60                   # I^2 column
x_tau2 <- 1.80                   # Tau^2 column
x_begg <- 2.00
x_egg  <- 2.20
x_left <- c(-0.7, -0.5, -0.3)  # Diagnostic, Studies, Samples
xlim   <- c(min(x_left)-0.4, 2.35) # change the space between virus and columns labels

k    <- nrow(pooled_results_df)
rows <- k:1  # explicit row positions

# Build estimate labels
est_lab <- sprintf("%.3f [% .2f, % .2f]",
                   pooled_results_df$PooledPrev_Random,
                   pooled_results_df$CI_Random_LB,
                   pooled_results_df$CI_Random_UB)

forest(
  x       = pooled_results_df$PooledPrev_Random,
  ci.lb   = pooled_results_df$CI_Random_LB,
  ci.ub   = pooled_results_df$CI_Random_UB,
  slab    = pooled_results_df$Virus,
  header  = "Virus",
  ilab    = cbind(pooled_results_df$Diagnostic, studies_fmt, samples_fmt),
  ilab.xpos = x_left + 0.15,
  rows    = rows,
  alim    = c(0, 1),
  xlim    = xlim,
  xlab    = "Pooled Prevalence",
  mlab    = "",
  refline = NA,
  psize   = 1,
  cex     = 1,
  spacing = 0.8,
  shade   = TRUE,
  annotate = FALSE,
)

# Column headers for the left-side info columns
text(x = x_left + 0.15, y = max(rows) + 2, labels = c("Diagnostic", "Studies", "Samples"),
     cex = 0.9, font = 2)
text(x = c(x_est, x_i2, x_tau2, x_begg, x_egg) , y = max(rows) + 2,
     labels = c("Pooled Prevalence [95% CI]", "I²", "Tau²", "Begg's", "Egger's p-val"), cex = 0.85, font = 2, adj = 0.5)

text(x = x_est,  y = rows, labels = est_lab,                           cex = 1, adj = 0.5)
text(x = x_i2,   y = rows, labels = sprintf("%.3f", pooled_results_df$I2),   cex = 1, adj = 0.5)
text(x = x_tau2, y = rows, labels = sprintf("%.3f", pooled_results_df$Tau2), cex = 1, adj = 0.5)
text(x = x_begg, y = rows, labels = sprintf("%.3f", pooled_results_df$Begg_Pval), cex = 1, adj = 0.5)
text(x = x_egg, y = rows, labels = sprintf("%.3f", pooled_results_df$Egger_Pval), cex = 1, adj = 0.5)

# Dashed vertical reference line
segments(x0 = 0.5, y0 = min(rows) - 0.5, x1 = 0.5, y1 = max(rows) + 0.5,
         lty = 2, col = "gray40", lwd = 1.5)

dev.off()

##---------------------- FUNNEL PLOTS (Egger's test) -------------------------##

library(meta)
library(dplyr)
library(stringr)

for (dataset_name in dataset_names) {
  
  data <- get(dataset_name)
  
  # Filter studies with at least 30 samples
  data <- data %>%
    filter(sample_size > 30)
  
  # Exclude studies using virus isolation
  data <- data %>%
    filter(diag_test != "Virus_isolation")
  
  # Skip datasets with fewer than 5 studies
  if (length(unique(data$pub_ID)) < 5) {
    message(paste0("⏩ Skipping ", dataset_name, ": fewer than 5 pub_IDs after filtering."))
    next
  }
  
  # Sort by sampling year
  data <- data %>%
    arrange(sampling_year)
  
  # Create study label
  data <- data %>%
    mutate(label = paste0(pub_ID, " (", sampling_year, ")"))
  
  
  # Meta-analysis object
  meta_res <- metaprop(
    event = positive_sample,
    n = sample_size,
    studlab = label,
    data = data,
    sm = "PLOGIT",         # Logit transformation
    method = "Inverse",
    comb.fixed = TRUE,
    comb.random = TRUE,
    method.tau = "REML",
    hakn = TRUE
  )
  
  # Egger test
  egger <- tryCatch({
    metabias(meta_res, method = "linreg")
  }, error = function(e) {
    message(paste0("⚠ Egger test failed for ", dataset_name))
    return(NULL)
  })
  
  # Dynamic figure size based on number of studies
  n_studies <- nrow(data)
  png_width <- 4000
  png_height <- max(2800, n_studies * 50)  # 50 px per study
  png_filename <- paste0("figures/funnel/Egger's Test/egger_", dataset_name, ".png")
  
  png(filename = png_filename, width = png_width, height = png_height, res = 300)
  
  # Make room below the plot for note + legend
  op <- par(no.readonly = TRUE)
  par(mar = c(9, 4, 2, 2))
  
  # Funnel plot
  funnel(meta_res,
         comb.fixed  = TRUE,
         comb.random = TRUE,
         xlab = "Prevalence (logit scale)",
         ylab = "Standard Error",
         studlab = FALSE,
         contour = c(0.9, 0.95, 0.99),
         col.contour = c("yellowgreen","orange2","indianred2"),
         pch = 19
  )
  
  # Notes in bottom margin (instead of labels on the plot)
  line_base <- 3
  if (exists("egger") && !is.null(egger)) {
    egger_text <- paste0("Egger's test: t = ", round(egger$statistic, 3),
                         ", p = ", signif(egger$p.value, 3))
    mtext(egger_text, side = 1, line = line_base + 1.5, cex = 1, adj = 0)
    line_base <- line_base + 1
  }
  mtext("Dashed vertical lines indicate pooled summaries: fixed-effect (left) and random-effects (right).",
        side = 1, line = line_base + 2, cex = 1, adj = 0)
  
  # Legend under the notes
  legend("bottomleft",
         inset = c(0.90, -0.225),   # adjust if needed
         xpd   = NA,
         title = "Contours",
         legend = c("p < 0.10","p < 0.05","p < 0.01"),
         fill   = c("yellowgreen","orange2","indianred2"),
         border = NA, bty = "n", cex = 1)
  
  par(op)
  
  dev.off()
  
  message(paste0("✅ Funnel plot created for ", dataset_name, " (", n_studies, " studies)"))
}

