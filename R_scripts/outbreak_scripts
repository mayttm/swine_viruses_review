create_combined_panel <- function(plot_list, output_file) {
  # Filter out NULL plots
  valid_plots <- plot_list[!sapply(plot_list, is.null)]
  if(length(valid_plots) == 0) {
    cat("⚠ No valid plots to combine\n")
    return(NULL)
  }
  n_plots <- length(valid_plots)
  
  # Simple 3x3 layout
  layout_matrix <- rbind(
    c(1, 2),
    c(3, 4),
    c(5, 6),   
    c(7, 7)   
  )
  heights <- c(1.5, 1, 1, 1)
  
  # Arrange plots
  combined_plot <- arrangeGrob(
    grobs = valid_plots,
    layout_matrix = layout_matrix,
    heights = heights
  )
  
  # Fixed dimensions for 3x3 layout
  plot_width <- 10
  plot_height <- 14
  
  # Save combined plot
  ggsave(output_file,
         combined_plot,
         width = plot_width,
         height = plot_height,
         dpi = 300,
         bg = "white")
  
  cat(paste0("✅ Combined panel saved: ", output_file, "\n"))
  cat(paste0("   Dimensions: ", plot_width, " × ", plot_height,
             " inches (", n_plots, " plots)\n"))
  
  return(combined_plot)
}

