create_sample_type_chart <- function(data, sample_cols, title) {
  sample_summary <- data %>%
    select(all_of(sample_cols)) %>%
    summarise(across(everything(), ~sum(. == 1 | . == "1" | tolower(.) == "yes", na.rm = TRUE))) %>%
    pivot_longer(everything(), names_to = "sample_type", values_to = "count") %>%
    arrange(desc(count)) %>%
    mutate(
      sample_type = str_replace(sample_type, "^sample_", ""),
      sample_type = str_to_title(str_replace_all(sample_type, "_", " ")),
      # Change "intes" to "intestine"
      sample_type = ifelse(tolower(sample_type) == "intes", "Intestine", sample_type),
      percentage = count / nrow(data) * 100,
      sample_type = factor(sample_type, levels = sample_type)
    )
  
  p <- ggplot(sample_summary, aes(x = 2, y = count, fill = sample_type)) +
    geom_bar(stat = "identity", width = 1, color = "white", size = 0.8) +
    coord_polar(theta = "y", start = 0) +
    xlim(0.5, 2.5) +
    theme_void() +
    theme(
      plot.title = element_text(hjust = 0.5, size = 13, face = "bold",
                                margin = margin(b = 10)),
      plot.background = element_rect(fill = "white", color = NA),
      panel.background = element_rect(fill = "white", color = NA),
      legend.position = "right",
      legend.title = element_blank(),
      legend.text = element_text(size = 8.5),
      legend.key.size = unit(0.7, "cm"),
      legend.background = element_rect(fill = "white", color = NA),
      plot.caption = element_text(size = 7.5, hjust = 0.5, color = "gray40",
                                  margin = margin(t = 5)),
      plot.margin = margin(10, 5, 10, 5) ,
      aspect.ratio = 1
    ) +
    labs(title = title,
         caption = "Note: Non-mutually exclusive categories") +
    scale_fill_manual(
      values = colorRampPalette(c("#8DD3C7", "#FFFFB3", "#BEBADA", "#FB8072",
                                  "#80B1D3", "#FDB462", "#B3DE69"))(
                                    nrow(sample_summary)),
      labels = function(x) {
        idx <- match(x, sample_summary$sample_type)
        paste0(str_wrap(x, 20), " (",
               sprintf("%.1f%%", sample_summary$percentage[idx]), ")")
      }
    )
  
  return(p)
}

# Function to create improved publication year bar chart
create_pub_year_bar <- function(data, var_name, title) {
  
  plot_data <- data %>%
    filter(!is.na(!!sym(var_name))) %>%
    count(!!sym(var_name)) %>%
    arrange(!!sym(var_name))
  
  p <- ggplot(plot_data, aes(x = factor(!!sym(var_name)), y = n)) +
    geom_bar(stat = "identity", fill = "#f78fa1", color = "white", 
             width = 0.75, alpha = 0.9) +
    geom_text(aes(label = n),
              vjust = -0.4, size = 3, fontface = "bold", color = "gray20") +
    theme_minimal() +
    theme(
      plot.title = element_text(hjust = 0.5, size = 13, face = "bold",
                                margin = margin(b = 10)),
      plot.background = element_rect(fill = "white", color = NA),
      panel.background = element_rect(fill = "white", color = NA),
      panel.grid.major.x = element_blank(),
      panel.grid.minor = element_blank(),
      panel.grid.major.y = element_line(color = "gray90", size = 0.3),
      axis.text.x = element_text(size = 9, color = "gray20"),
      axis.text.y = element_text(size = 9, color = "gray20"),
      axis.title = element_text(size = 10, face = "bold", color = "gray20"),
      plot.margin = margin(15, 15, 15, 15)
    ) +
    labs(title = title,
         x = "Publication Year",
         y = "Number of Studies") +
    scale_y_continuous(expand = expansion(mult = c(0, 0.12)))
  
  return(p)
}

