create_yearly_outbreak <- function(df) {
  years <- sort(unique(df$sampling_year))
  yearly_list <- list()
  for (yr in years) {
    df_year <- df %>%
      filter(sampling_year == yr) %>%
      group_by(province, virus) %>%
      summarise(
        avg_prevalence = sum(positive_sample, na.rm = TRUE) / sum(sample_size, na.rm = TRUE),
        .groups = "drop"
      ) %>%
      pivot_wider(
        names_from = virus,
        values_from = avg_prevalence,
        values_fill = 0
      )
    yearly_list[[as.character(yr)]] <- df_year
  }
  yearly_list
}

yearly_outbreaks <- create_yearly_outbreak(data_outb_single)

map_yearly_outbreak <- function(year_df, shapefile_sf, year, base_size = 12, line_width = 0.25) {
  year_df <- as.data.frame(year_df)
  
  year_long <- year_df %>%
    pivot_longer(
      cols = -province,
      names_to = "virus",
      values_to = "prevalence"
    ) %>%
    filter(prevalence > 0)
  
  # Only keep viruses that are actually detected AND have defined colors
  detected_viruses <- intersect(unique(year_long$virus), names(pathogen_molec_colors))
  
  # If nothing detected, return a blank map with a note
  if (length(detected_viruses) == 0) {
    return(
      ggplot() +
        geom_sf(data = shapefile_sf, fill = "grey90", color = "grey40", linewidth = line_width) +
        labs(title = paste0("Outbreaks in ", year), subtitle = "No outbreaks recorded") +
        theme(
          legend.position = "none",
          plot.title = element_text(size = base_size + 2, family = "sans", face = "bold"),
          plot.subtitle = element_text(size = base_size - 1, family = "sans")
        )
    )
  }
  
  year_long <- year_long %>%
    filter(virus %in% detected_viruses) %>%
    group_by(province) %>%
    arrange(province, virus, .by_group = TRUE) %>%
    mutate(rank = row_number()) %>%
    ungroup()
  
  map_long <- shapefile_sf %>%
    inner_join(year_long, by = c("province_shp" = "province")) %>%
    st_as_sf()
  
  first_virus    <- filter(map_long, rank == 1)
  stripe_viruses <- filter(map_long, rank > 1)
  
  provinces_with_outbreak <- unique(map_long$province_shp)
  subtitle_text <- paste(provinces_with_outbreak, collapse = ", ")
  
  ggplot() +
    geom_sf(data = shapefile_sf, fill = "grey90", color = "grey40", linewidth = line_width) +
    geom_sf(data = first_virus, aes(fill = virus), color = "black", linewidth = line_width, show.legend = TRUE) +
    geom_sf_pattern(
      data = stripe_viruses,
      aes(pattern_fill = virus),
      fill = NA,
      pattern = "stripe",
      color = "black",
      linewidth = line_width,
      pattern_density = 0.5,
      pattern_spacing = 0.02,
      pattern_angle = 45,
      show.legend = FALSE
    ) +
    # Only show detected viruses in the legend
    scale_fill_manual(values = pathogen_molec_colors, limits = detected_viruses, drop = TRUE) +
    scale_pattern_fill_manual(values = pathogen_molec_colors, limits = detected_viruses, drop = TRUE) +
    labs(title = paste0("Outbreaks in ", year), subtitle = subtitle_text) +
    coord_sf(expand = FALSE) +
    theme(
      legend.title = element_blank(),
      plot.title = element_text(size = base_size + 2, family = "sans"),
      plot.subtitle = element_text(size = base_size - 1, family = "sans"),
      legend.text = element_text(size = base_size - 1, family = "sans")
    )
}

