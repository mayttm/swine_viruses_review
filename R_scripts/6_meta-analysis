## ------------- Combined Pooled Prevalence with Trim-and-Fill -------------- ##
library(metafor)
library(meta)
library(dplyr)
library(tidyr)
library(stringr)
library(ragg)

pooled_results <- list()
dataset_names <- ls(pattern = "^df_")

for (dataset_name in dataset_names) {
  data <- get(dataset_name)
  
  # Harmonize column names
  if (!"sample_size" %in% names(data)) {
    if ("n" %in% names(data)) data <- dplyr::rename(data, sample_size = n)
    else if ("N" %in% names(data)) data <- dplyr::rename(data, sample_size = N)
  }
  
  # Check required columns
  required <- c("sample_size","positive_sample","diag_test","pub_ID","sampling_year")
  missing <- setdiff(required, names(data))
  if (length(missing)) {
    message(paste0("⏩ Skipping ", dataset_name, ": missing columns: ", paste(missing, collapse=", ")))
    next
  }
  
  # Filter studies
  data <- data %>%
    filter(sample_size >= 30,
           diag_test != "Virus_isolation")
  
  # Skip datasets with fewer than 5 studies
  if (dplyr::n_distinct(data$pub_ID) < 5) {
    message(paste0("⏩ Skipping ", dataset_name, ": fewer than 5 pub_IDs after filtering."))
    next
  }
  
  # Sort and create study labels
  data <- data %>%
    arrange(sampling_year) %>%
    mutate(label = make.unique(as.character(pub_ID)))
  
  # Meta-analysis
  meta_res <- tryCatch(
    {
      metaprop(
        event = positive_sample,
        n = sample_size,
        studlab = label,
        data = data,
        sm = "PLOGIT",
        method = "Inverse",
        comb.fixed = TRUE,
        comb.random = TRUE,
        method.tau = "REML",
        hakn = TRUE,
        prediction = TRUE
      )
    },
    error = function(e) {
      message(paste0("⚠ Meta-analysis failed for ", dataset_name, ": ", e$message))
      return(NULL)
    }
  )
  
  if (is.null(meta_res)) next
  
  # ===== TRIM-AND-FILL ANALYSIS =====
  tf_res <- tryCatch({
    trimfill(meta_res)
  }, error = function(e) {
    message(paste0("⚠ Trim-and-fill failed for ", dataset_name))
    return(NULL)
  })
  
  # Extract trim-and-fill results
  if (!is.null(tf_res)) {
    n_imputed <- tf_res$k0
    prev_adjusted <- meta::backtransf(tf_res$TE.random, sm = meta_res$sm)
    ciA_lb <- meta::backtransf(tf_res$lower.random, sm = meta_res$sm)
    ciA_ub <- meta::backtransf(tf_res$upper.random, sm = meta_res$sm)
    
    # Calculate impact
    prev_random <- meta::backtransf(meta_res$TE.random, sm = meta_res$sm)
    abs_diff <- prev_adjusted - prev_random
    rel_change <- (abs_diff / prev_random) * 100
    
    # Print comparison
    message(paste0("\n🔍 Trim-and-Fill Impact for ", dataset_name, ":"))
    message(paste0("   Original prevalence: ", round(prev_random, 3)))
    message(paste0("   Adjusted prevalence: ", round(prev_adjusted, 3)))
    message(paste0("   Absolute difference: ", round(abs_diff, 3)))
    message(paste0("   Relative change: ", round(rel_change, 1), "%"))
    message(paste0("   Number of imputed studies: ", n_imputed))
    message(paste0("   Interpretation: ", 
                   ifelse(n_imputed == 0, "No adjustment needed",
                          ifelse(abs(rel_change) < 10, "Minimal impact",
                                 ifelse(abs(rel_change) < 20, "Moderate impact", "Substantial impact")))))
  } else {
    n_imputed <- NA
    prev_adjusted <- NA
    ciA_lb <- NA
    ciA_ub <- NA
    abs_diff <- NA
    rel_change <- NA
  }
  
  # ===== PUBLICATION BIAS TESTS =====
  begg_pval <- tryCatch({
    begg_test <- metabias(meta_res, method = "rank")
    as.numeric(begg_test$p.value)
  }, error = function(e) {
    message(paste0("⚠ Begg's test failed for ", dataset_name))
    return(NA)
  })
  
  egger_pval <- tryCatch({
    egger_test <- metabias(meta_res, method = "linreg")
    as.numeric(egger_test$p.value)
  }, error = function(e) {
    message(paste0("⚠ Egger's test failed for ", dataset_name))
    return(NA)
  })
  
  # Summaries
  num_studies <- dplyr::n_distinct(data$pub_ID)
  total_sample_size <- sum(data$sample_size, na.rm = TRUE)
  
  # Back-transform pooled estimates and intervals
  prev_fixed   <- meta::backtransf(meta_res$TE.fixed,        sm = meta_res$sm)
  ciF_lb       <- meta::backtransf(meta_res$lower.fixed,     sm = meta_res$sm)
  ciF_ub       <- meta::backtransf(meta_res$upper.fixed,     sm = meta_res$sm)
  
  prev_random  <- meta::backtransf(meta_res$TE.random,       sm = meta_res$sm)
  ciR_lb       <- meta::backtransf(meta_res$lower.random,    sm = meta_res$sm)
  ciR_ub       <- meta::backtransf(meta_res$upper.random,    sm = meta_res$sm)
  
  pi_lb        <- meta::backtransf(meta_res$lower.predict,   sm = meta_res$sm)
  pi_ub        <- meta::backtransf(meta_res$upper.predict,   sm = meta_res$sm)
  
  # Save results
  pooled_results[[dataset_name]] <- data.frame(
    Dataset            = dataset_name,
    NumStudies         = num_studies,
    TotalSampleSize    = total_sample_size,
    
    # Fixed-effect model
    PooledPrev_Fixed   = prev_fixed,
    CI_Fixed_LB        = ciF_lb,
    CI_Fixed_UB        = ciF_ub,
    
    # Random-effects model (PRIMARY)
    PooledPrev_Random  = prev_random,
    CI_Random_LB       = ciR_lb,
    CI_Random_UB       = ciR_ub,
    
    # Prediction interval
    PI_Random_LB       = pi_lb,
    PI_Random_UB       = pi_ub,
    
    # Heterogeneity
    I2                 = meta_res$I2,
    Tau2               = meta_res$tau2,
    
    # Publication bias tests
    Begg_Pval          = begg_pval,
    Egger_Pval         = egger_pval,
    
    # Trim-and-fill results
    N_Imputed_Studies  = n_imputed,
    PooledPrev_Adjusted = prev_adjusted,
    CI_Adjusted_LB     = ciA_lb,
    CI_Adjusted_UB     = ciA_ub,
    Prevalence_Diff    = abs_diff,
    Relative_Change_Pct = rel_change,
    
    # Publication bias impact classification
    PubBias_Impact = ifelse(is.na(n_imputed), NA,
                            ifelse(n_imputed == 0, "No evidence",
                                   ifelse(abs(rel_change) < 10, "Minimal",
                                          ifelse(abs(rel_change) < 20, "Moderate", "Substantial")))),
    
    stringsAsFactors   = FALSE
  )
}

# Combine all pooled results into one dataframe
pooled_results_df <- do.call(rbind, pooled_results)

# Clean dataset names
pooled_results_df$CleanName  <- str_replace(pooled_results_df$Dataset, "^df_", "")
pooled_results_df$Diagnostic <- str_extract(pooled_results_df$CleanName, "^[^_]+")
pooled_results_df <- pooled_results_df %>%
  mutate(
    Virus = case_when(
      CleanName == "serological_IAV_H1N1" ~ "IAV_H1N1",
      TRUE ~ str_extract(CleanName, "[^_]+$")
    )
  )

pooled_results_df$NumStudies <- pooled_results_df$NumStudies
pooled_results_df$NumSamples <- pooled_results_df$TotalSampleSize

# Sort in descending order of pooled prevalence (random-effects estimate)
pooled_results_df <- pooled_results_df %>%
  arrange(desc(PooledPrev_Random))

# Filter out serological data
pooled_results_df <- pooled_results_df %>%
  filter(tolower(Diagnostic) != "serological")

# Export comprehensive CSV
write.csv(pooled_results_df, 
          file = "output/statistics/pooled_prevalence_summary_with_trimfill.csv", 
          row.names = FALSE)

message(paste0("\n✅ Exported comprehensive results with trim-and-fill statistics"))

# ===== VISUALIZATION =====
studies_fmt <- pooled_results_df$NumStudies
samples_fmt <- format(pooled_results_df$NumSamples, big.mark=",")

# Function to create the forest plot
create_forest_plot <- function() {
  par(family = "sans")
  par(mar = c(4, 6, 4, 4))
  
  # Column positions
  x_est     <- 1.30    # "Estimate [95% CI]"
  x_adj     <- 1.70    # Adjusted prevalence
  x_i2      <- 1.90    # I^2
  x_tau2    <- 2.10    # Tau^2
  x_begg    <- 2.30    # Begg's p
  x_egg     <- 2.50    # Egger's p
  x_imputed <- 2.80    # N imputed
  x_left    <- c(-0.8, -0.6, -0.4)  # Diagnostic, Studies, Samples
  xlim   <- c(min(x_left)-0.4, 2.95)
  
  k    <- nrow(pooled_results_df)
  rows <- k:1
  
  # Build estimate labels
  est_lab <- sprintf("%.3f [%.2f, %.2f]",
                     pooled_results_df$PooledPrev_Random,
                     pooled_results_df$CI_Random_LB,
                     pooled_results_df$CI_Random_UB)
  
  # Adjusted prevalence labels
  adj_lab <- ifelse(!is.na(pooled_results_df$PooledPrev_Adjusted),
                    sprintf("%.3f",
                            pooled_results_df$PooledPrev_Adjusted),
                    "-")
  
  # Forest plot
  forest(
    x       = pooled_results_df$PooledPrev_Random,
    ci.lb   = pooled_results_df$CI_Random_LB,
    ci.ub   = pooled_results_df$CI_Random_UB,
    slab    = pooled_results_df$Virus,
    header  = "Virus",
    ilab    = cbind(pooled_results_df$Diagnostic, studies_fmt, samples_fmt),
    ilab.xpos = x_left + 0.15,
    rows    = rows,
    alim    = c(0, 1),
    xlim    = xlim,
    xlab    = "Pooled Prevalence",
    mlab    = "",
    refline = NA,
    psize   = 1,
    cex     = 0.9,
    spacing = 0.8,
    shade   = TRUE,
    annotate = FALSE
  )
  
  # Column headers
  text(x = x_left + 0.15, y = max(rows) + 2,
       labels = c("Diagnostic", "Studies", "Samples"),
       cex = 0.8, font = 2)
  text(x = c(x_est, x_adj, x_i2, x_tau2, x_begg, x_egg, x_imputed),
       y = max(rows) + 2,
       labels = c("Pooled Prev [95% CI]", "Adj. Prev", "I²", "Tau²",
                  "Begg's p", "Egger's p", "Imputed No."),
       cex = 0.8, font = 2, adj = 0.5)
  
  # Data columns
  text(x = x_est,     y = rows, labels = est_lab, cex = 0.9, adj = 0.5)
  text(x = x_adj,     y = rows, labels = adj_lab, cex = 0.9, adj = 0.5)
  text(x = x_i2,      y = rows, labels = sprintf("%.3f", pooled_results_df$I2), cex = 0.9, adj = 0.5)
  text(x = x_tau2,    y = rows, labels = sprintf("%.3f", pooled_results_df$Tau2), cex = 0.9, adj = 0.5)
  text(x = x_begg,    y = rows, labels = sprintf("%.3f", pooled_results_df$Begg_Pval), cex = 0.9, adj = 0.5)
  text(x = x_egg,     y = rows, labels = sprintf("%.3f", pooled_results_df$Egger_Pval), cex = 0.9, adj = 0.5)
  text(x = x_imputed, y = rows,
       labels = ifelse(is.na(pooled_results_df$N_Imputed_Studies), "-",
                       as.character(pooled_results_df$N_Imputed_Studies)),
       cex = 0.9, adj = 0.5)
  
  # Reference line
  segments(x0 = 0.5, y0 = min(rows) - 0.5, x1 = 0.5, y1 = max(rows) + 0.5,
           lty = 2, col = "gray40", lwd = 1.5)
}

