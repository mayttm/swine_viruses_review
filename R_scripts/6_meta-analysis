# Create output directory for statistics
dir.create("output/statistics", recursive = TRUE, showWarnings = FALSE)

# Initialize data frame to collect forest plot eligibility statistics
forest_plot_summary <- data.frame(
  dataset = character(),
  total_rows_raw = integer(),
  n_rows_after_sample_filter = integer(),
  n_rows_after_diag_filter = integer(),
  n_unique_pub_ids = integer(),
  meets_pub_id_criteria = character(),
  meets_sample_size_criteria = character(),
  meets_overall_criteria = character(),
  reason_excluded = character(),
  stringsAsFactors = FALSE
)

dataset_names <- ls(pattern = "^df_")

for (dataset_name in dataset_names) {
  data <- get(dataset_name)
  # Track original size
  total_rows_raw <- nrow(data)
  # Filter studies with at least 30 samples
  data_sample_filtered <- data %>%
    filter(sample_size >= 30)
  n_rows_after_sample <- nrow(data_sample_filtered)
  # Check if sample_size >= 30 for ALL remaining rows
  meets_sample_criteria <- n_rows_after_sample > 0 &&
    all(data_sample_filtered$sample_size >= 30)
  # Exclude studies using virus isolation
  data_filtered <- data_sample_filtered %>%
    filter(diag_test != "Virus_isolation")
  n_rows_after_diag <- nrow(data_filtered)
  n_unique_pubs <- length(unique(data_filtered$pub_ID))
  # Check criteria
  meets_pub_id_criteria <- n_unique_pubs >= 5
  meets_overall <- meets_pub_id_criteria && meets_sample_criteria
  # Determine reason for exclusion
  if (!meets_overall) {
    if (n_rows_after_sample == 0) {
      reason <- "No studies with sample_size >= 30"
    } else if (!meets_sample_criteria) {
      reason <- "Some studies have sample_size < 30"
    } else if (n_rows_after_diag == 0) {
      reason <- "No studies after excluding virus isolation"
    } else if (!meets_pub_id_criteria) {
      reason <- paste0("Only ", n_unique_pubs, " pub_IDs (need ≥5)")
    } else {
      reason <- "Unknown exclusion reason"
    }
  } else {
    reason <- "Meets all criteria - forest plot created"
  }
  # Store statistics
  forest_plot_summary <- rbind(forest_plot_summary, data.frame(
    dataset = str_replace(dataset_name, "^df_", ""),
    total_rows_raw = total_rows_raw,
    n_rows_after_sample_filter = n_rows_after_sample,
    n_rows_after_diag_filter = n_rows_after_diag,
    n_unique_pub_ids = n_unique_pubs,
    meets_pub_id_criteria = ifelse(meets_pub_id_criteria, "Yes", "No"),
    meets_sample_size_criteria = ifelse(meets_sample_criteria, "Yes", "No"),
    meets_overall_criteria = ifelse(meets_overall, "Yes", "No"),
    reason_excluded = reason,
    stringsAsFactors = FALSE
  ))
  # Skip if criteria not met
  if (!meets_overall) {
    message(paste0("⏩ Skipping ", dataset_name, ": ", reason))
    next
  }
  # Continue with forest plot creation
  data <- data_filtered
  # Sort by sampling year
  data <- data %>%
    arrange(sampling_year)
  # Create study label
  data <- data %>%
    mutate(label = paste0(pub_ID))
  # Meta-analysis object using {meta}
  meta_res <- metaprop(
    event = positive_sample,
    n = sample_size,
    studlab = label,
    data = data,
    sm = "PLOGIT",
    method = "Inverse",
    comb.fixed = FALSE,
    comb.random = TRUE,
    method.tau = "REML",
    hakn = TRUE,
    prediction = TRUE
  )
  # ===== PUBLICATION BIAS ASSESSMENT =====
  # Perform trim-and-fill analysis
  tf_res <- trimfill(meta_res)
  # Extract key information
  n_imputed <- tf_res$k0  # Number of imputed studies
  pooled_original <- meta_res$TE.random
  pooled_adjusted <- tf_res$TE.random
  # Calculate adjusted prevalence and 95% CI
  adj_prev <- exp(pooled_adjusted) / (1 + exp(pooled_adjusted))
  adj_lower <- exp(tf_res$lower.random) / (1 + exp(tf_res$lower.random))
  adj_upper <- exp(tf_res$upper.random) / (1 + exp(tf_res$upper.random))
  # Create annotation text
  if (n_imputed > 0) {
    annotation_text <- paste0("Trim-and-fill analysis imputed ", n_imputed, " data")
  } else {
    annotation_text <- "Trim-and-fill: No studies imputed (no publication bias detected)"
  }
  # Print publication bias results
  message(paste0("\n📊 Publication Bias Assessment for ", dataset_name, ":"))
  message(paste0("   Number of studies: ", meta_res$k))
  message(paste0("   Imputed studies (trim-and-fill): ", n_imputed))
  message(paste0("   Original pooled prevalence: ", round(exp(pooled_original)/(1+exp(pooled_original)), 3)))
  message(paste0("   Adjusted pooled prevalence: ", round(adj_prev, 3),
                 " (95% CI: ", round(adj_lower, 3), "-", round(adj_upper, 3), ")"))
  # Function to create funnel plot
  create_funnel_plot <- function() {
    funnel(tf_res,
           xlab = "Prevalence (logit scale)",
           studlab = TRUE,
           cex = 0.8)
    title(paste0("Funnel Plot with Trim-and-Fill: ",
                 str_replace_all(str_replace(dataset_name, "^df_", ""), "_", " ")))
  }
  # Save funnel plot in multiple formats
  # TIFF
  tiff(
    filename = paste0("figures/funnel/trim-and-filled/funnel_", dataset_name, ".tiff"),
    width = 3000,
    height = 2400,
    units = "px",
    res = 300,
    compression = "lzw"
  )
  create_funnel_plot()
  dev.off()
  # JPEG
  jpeg(
    filename = paste0("figures/funnel/trim-and-filled/funnel_", dataset_name, ".jpg"),
    width = 3000,
    height = 2400,
    units = "px",
    res = 300,
    quality = 95
  )
  create_funnel_plot()
  dev.off()
  # PDF
  pdf(
    file = paste0("figures/funnel/trim-and-filled/funnel_", dataset_name, ".pdf"),
    width = 10,
    height = 8
  )
  create_funnel_plot()
  dev.off()
  # Clean title for forest plot
  plot_title <- dataset_name %>%
    str_replace("^df_", "") %>%
    str_replace_all("_", " ")
  # Zebra-style shading by pub_ID
  shade_groups <- as.numeric(factor(data$pub_ID)) %% 2 != 0
  # Dynamic font & margin scaling
  n_studies  <- nrow(data)
  cex_value  <- min(0.9, 800 / n_studies + 20)
  mar_bottom <- max(2, 2 + n_studies * 0.1)
  mar_left   <- max(1, 1 + n_studies * 0.05)
  # Figure dimensions
  tiff_width  <- 4000
  tiff_height <- max(2800, n_studies * 100)
  # Function to create forest plot
  create_forest_plot <- function() {
    par(family = "sans")
    par(mar = c(mar_bottom, mar_left, 6, 10))
    forest(
      meta_res,
      sortvar = data$sampling_year,
      smlab = "",
      leftcols = c("studlab", "diag_test_details", "sampling_year", "n"),
      leftlabs = c("Study", "Diagnostic Test", "Sampling Year", "Sample Size"),
      rightcols = c("effect", "ci", "w.random"),
      rightlabs = c("Prevalence", "95% CI", "Weight"),
      comb.fixed = FALSE,
      comb.random = TRUE,
      text.random = "Random-effects Pooled Prevalence",
      prediction = TRUE,
      col.predict = "darkblue",
      col.diamond.random = "red",
      col.diamond.lines = "black",
      shade = shade_groups,
      print.tau2 = TRUE,
      print.I2 = TRUE,
      print.tau2.ci = FALSE,
      test.overall.random = TRUE,
      xlab = "Pooled Prevalence",
      xlim = c(0, 1),
      just = "center",
      cex = cex_value,
      cex.lab = cex_value,
      colgap.forest.left = "2cm",
      spacing = 1.15,
      addrow.overall = TRUE,
      text.addline1 = paste0("Adjusted Pooled Prevalence (Trim-and-Fill): ",
                             sprintf("%.3f", adj_prev)),
      effect.addline1 = adj_prev,
      ci.addline1 = c(adj_lower, adj_upper),
      col.diamond.addline1 = "darkblue",
      text.addline2 = annotation_text,
      just.addline2 = "left",
      cex.addline2 = cex_value * 0.85,
      col.addline2 = if(n_imputed > 0) "darkblue" else "darkgreen"
    )
  }
  # Save forest plot in multiple formats
  # TIFF
  ragg::agg_tiff(
    filename = paste0("figures/forest/forest_", dataset_name, ".tiff"),
    width = tiff_width,
    height = tiff_height,
    units = "px",
    res = 300,
    compression = "lzw",
    background = "white"
  )
  create_forest_plot()
  dev.off()
  # JPEG
  jpeg(
    filename = paste0("figures/forest/forest_", dataset_name, ".jpg"),
    width = tiff_width,
    height = tiff_height,
    units = "px",
    res = 300,
    quality = 95
  )
  create_forest_plot()
  dev.off()
  # PDF
  pdf(
    file = paste0("figures/forest/forest_", dataset_name, ".pdf"),
    width = tiff_width / 300,
    height = tiff_height / 300
  )
  create_forest_plot()
  dev.off()
  message(paste0("✅ Forest and funnel plots created for ", dataset_name, " (", n_studies, " studies)"))
  message(paste0("   Formats: TIFF, JPEG, PDF"))
}
