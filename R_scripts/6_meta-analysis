library(meta)
library(dplyr)
library(stringr)

# Function to summarize publication bias tests
summarize_pub_bias <- function(dataset_name, egger_result, begg_result, n_studies) {
  # Egger's test
  egger_stat <- if (!is.null(egger_result)) round(egger_result$statistic, 3) else NA
  egger_p <- if (!is.null(egger_result)) signif(egger_result$p.value, 3) else NA
  egger_interp <- if (!is.null(egger_result)) {
    ifelse(egger_result$p.value < 0.05, "Significant asymmetry detected", "No significant asymmetry")
  } else NA
  
  # Begg's test
  begg_stat <- if (!is.null(begg_result)) round(begg_result$statistic, 3) else NA
  begg_p <- if (!is.null(begg_result)) signif(begg_result$p.value, 3) else NA
  begg_interp <- if (!is.null(begg_result)) {
    ifelse(begg_result$p.value < 0.05, "Significant asymmetry detected", "No significant asymmetry")
  } else NA
  
  # Overall interpretation
  overall <- if (!is.na(egger_p) && !is.na(begg_p)) {
    if (egger_p < 0.05 && begg_p < 0.05) {
      "Both tests indicate publication bias"
    } else if (egger_p < 0.05 || begg_p < 0.05) {
      "Mixed evidence of publication bias"
    } else {
      "No strong evidence of publication bias"
    }
  } else NA
  
  data.frame(
    dataset = dataset_name,
    n_studies = n_studies,
    egger_t = egger_stat,
    egger_p = egger_p,
    egger_interpretation = egger_interp,
    begg_z = begg_stat,
    begg_p = begg_p,
    begg_interpretation = begg_interp,
    overall_interpretation = overall
  )
}

# Initialize results collector
pub_bias_results <- list()

# Main loop
for (dataset_name in dataset_names) {
  data <- get(dataset_name)
  
  # Track original size
  total_rows_raw <- nrow(data)
  
  # Filter studies with at least 30 samples
  data_sample_filtered <- data %>%
    filter(sample_size >= 30)
  n_rows_after_sample <- nrow(data_sample_filtered)
  
  # Check if sample_size >= 30 for ALL remaining rows
  meets_sample_criteria <- n_rows_after_sample > 0 &&
    all(data_sample_filtered$sample_size >= 30)
  
  # Exclude studies using virus isolation
  data_filtered <- data_sample_filtered %>%
    filter(diag_test != "Virus_isolation")
  n_rows_after_diag <- nrow(data_filtered)
  n_unique_pubs <- length(unique(data_filtered$pub_ID))
  
  # Check criteria
  meets_pub_id_criteria <- n_unique_pubs >= 5
  meets_overall <- meets_pub_id_criteria && meets_sample_criteria
  
  # Determine reason for exclusion
  if (!meets_overall) {
    if (n_rows_after_sample == 0) {
      reason <- "No studies with sample_size >= 30"
    } else if (!meets_sample_criteria) {
      reason <- "Some studies have sample_size < 30"
    } else if (n_rows_after_diag == 0) {
      reason <- "No studies after excluding virus isolation"
    } else if (!meets_pub_id_criteria) {
      reason <- paste0("Only ", n_unique_pubs, " pub_IDs (need ≥5)")
    } else {
      reason <- "Unknown exclusion reason"
    }
    message(paste0("⏩ Skipping ", dataset_name, ": ", reason))
    next
  }
  
  # Use filtered data
  data <- data_filtered
  
  # Sort by sampling year
  data <- data %>%
    arrange(sampling_year)
  
  # Create study label
  data <- data %>%
    mutate(label = paste0(pub_ID, " (", sampling_year, ")"))
  
  # Meta-analysis object (random-effects only)
  meta_res <- metaprop(
    event = positive_sample,
    n = sample_size,
    studlab = label,
    data = data,
    sm = "PLOGIT",
    method = "Inverse",
    comb.fixed = FALSE,
    comb.random = TRUE,
    method.tau = "REML",
    hakn = TRUE
  )
  
  # Egger's test
  egger <- tryCatch({
    metabias(meta_res, method = "linreg")
  }, error = function(e) {
    message(paste0("⚠ Egger's test failed for ", dataset_name))
    return(NULL)
  })
  
  # Begg's rank correlation test
  begg <- tryCatch({
    metabias(meta_res, method = "rank")
  }, error = function(e) {
    message(paste0("⚠ Begg's rank test failed for ", dataset_name))
    return(NULL)
  })
  
  # Store results
  n_studies <- nrow(data)
  pub_bias_results[[dataset_name]] <- summarize_pub_bias(dataset_name, egger, begg, n_studies)
  
  # Dynamic figure size based on number of studies
  fig_width <- 4000
  fig_height <- max(2800, n_studies * 50)
  
  # Base filename
  base_filename <- paste0("figures/funnel/funnel_", dataset_name)
  
  # Function to create the funnel plot
  create_funnel_plot <- function() {
    # Make room below the plot for notes + legend
    op <- par(no.readonly = TRUE)
    par(mar = c(10, 4, 2, 2))
    
    # Funnel plot (random-effects only)
    funnel(meta_res,
           comb.fixed = FALSE,
           comb.random = TRUE,
           xlab = "Prevalence (logit scale)",
           ylab = "Standard Error",
           studlab = FALSE,
           contour = c(0.9, 0.95, 0.99),
           col.contour = c("yellowgreen", "orange2", "indianred2"),
           pch = 19
    )
    
    # Add test results in bottom margin
    line_base <- 3
    if (!is.null(egger)) {
      egger_text <- paste0("Egger's test: t = ", round(egger$statistic, 3),
                           ", p = ", signif(egger$p.value, 3))
      mtext(egger_text, side = 1, line = line_base + 0.5, cex = 1, adj = 0)
      line_base <- line_base + 1.2
    }
    if (!is.null(begg)) {
      begg_text <- paste0("Begg's rank test: z = ", round(begg$statistic, 3),
                          ", p = ", signif(begg$p.value, 3))
      mtext(begg_text, side = 1, line = line_base + 0.5, cex = 1, adj = 0)
      line_base <- line_base + 1.2
    }
    mtext("Dashed vertical line indicates pooled random-effects summary.",
          side = 1, line = line_base + 1, cex = 1, adj = 0)
    
    # Legend
    legend("bottomleft",
           inset = c(0.90, -0.27),
           xpd = NA,
           title = "Contours",
           legend = c("p < 0.10", "p < 0.05", "p < 0.01"),
           fill = c("yellowgreen", "orange2", "indianred2"),
           border = NA, bty = "n", cex = 1)
    
    par(op)
  }
  
  # Export as TIFF
  tiff(filename = paste0(base_filename, ".tiff"),
       width = fig_width, height = fig_height, res = 300)
  create_funnel_plot()
  dev.off()
  
  # Export as PDF
  pdf(file = paste0(base_filename, ".pdf"),
      width = fig_width/300, height = fig_height/300)
  create_funnel_plot()
  dev.off()
  
  # Export as JPG
  jpeg(filename = paste0(base_filename, ".jpg"),
       width = fig_width, height = fig_height, res = 300, quality = 95)
  create_funnel_plot()
  dev.off()
  
  message(paste0("✅ Funnel plots created for ", dataset_name, " (", n_studies, " studies) in TIFF, PDF, and JPG"))
}

# Export publication bias statistics
if (length(pub_bias_results) > 0) {
  pub_bias_df <- bind_rows(pub_bias_results)
  write.csv(pub_bias_df,
            "output/statistics/publication_bias_tests.csv",
            row.names = FALSE)
  message("✅ Publication bias statistics exported to output/statistics/publication_bias_tests.csv")
}
