# 1. Clean data
data_surv_single <- data_surv_single %>%
  mutate(
    virus = trimws(virus),
    province = trimws(province)
  )

# 2. Calculate virus prevalence 
virus_freq <- data_surv_single %>%
  count(virus, name = "n") %>%
  mutate(freq = n / nrow(data_surv_single))

# 3. Identify viruses below threshold 
low_freq_viruses <- virus_freq %>%
  filter(freq < 0.01) %>%
  pull(virus)

# 4. Group viruses
data_surv_single <- data_surv_single %>%
  mutate(
    virus_group = case_when(
      virus %in% c("PCV2", "PCV3", "PCV4") ~ "PCV",
      virus %in% c("TTV", "TTSuV") ~ "TTV",
      virus %in% low_freq_viruses ~ "Others",
      TRUE ~ virus
    )
  )

unique(data_surv_single$virus_group)

