# step 2. create a function for province-Level Summary
library(dplyr)
library(tidyr)


process_province_data <- function(data) {
  # Filter only independent samples
  data <- data %>%
    filter(independent_sample == "yes")
  
  if (nrow(data) == 0) {
    warning(paste("No independent samples found for", title))
    return(NULL)
  }
  # Step 2: Province-Level Summary
  province_profile <- data %>%
    group_by(province) %>%
    summarise(
      frequency_pub_ID = n_distinct(pub_ID),   # Unique publications
      frequency_virus_studied = n_distinct(virus), # Unique virus groups studied
      frequency_virus_detected = n_distinct(virus[positive_sample > 0]),
      sample_number = sum(sample_size, na.rm = TRUE),
      total_positive = sum(positive_sample, na.rm = TRUE),
      average_prevalence = ifelse(sample_number > 0, total_positive / sample_number, NA),
      min_sampling_year = min(sampling_year, na.rm = TRUE),  # Earliest year
      max_sampling_year = max(sampling_year, na.rm = TRUE),  # Newest year
      .groups = "drop"
    )
  
  # Step 3: Positive sample per Virus Group per Province
  virus_group_profile <- data %>%
    mutate(
      virus_group_mod = case_when(
        virus_group == "IAV" & grepl("H1N1", subtype_strain, ignore.case = TRUE) ~ "IAV_H1N1",
        virus_group == "PCV" & grepl("PCV2", virus, ignore.case = TRUE) ~ "PCV2",
        virus_group == "PCV" & grepl("PCV3", virus, ignore.case = TRUE) ~ "PCV3",
        TRUE ~ virus_group
      )
    ) %>%
    group_by(province, virus_group_mod) %>%
    summarise(positive_sample_group = sum(positive_sample, na.rm = TRUE), .groups = "drop") %>%
    pivot_wider(
      names_from = virus_group_mod,
      values_from = positive_sample_group,
      values_fill = list(positive_sample_group = 0)
    ) %>%
    select(-any_of(c("IAV", "PCV")))
  
  # Step 4: Weighted Average Prevalence per Virus Group per Province
  virus_group_prevalence <- data %>%
    mutate(
      virus_group_mod = case_when(
        virus_group == "IAV" & grepl("H1N1", subtype_strain, ignore.case = TRUE) ~ "IAV_H1N1",
        virus_group == "PCV" & grepl("PCV2", virus, ignore.case = TRUE) ~ "PCV2",
        virus_group == "PCV" & grepl("PCV3", virus, ignore.case = TRUE) ~ "PCV3",
        TRUE ~ virus_group
      )
    ) %>%
    group_by(province, virus_group_mod) %>%
    summarise(
      avg_prevalence = sum(positive_sample, na.rm = TRUE) / sum(sample_size, na.rm = TRUE),
      .groups = "drop"
    ) %>%
    pivot_wider(
      names_from = virus_group_mod,
      values_from = avg_prevalence,
      names_prefix = "avg_prev_",
      values_fill = list(avg_prevalence = 0)
    )
  
  # Step 5: Merge All Profiles
  province_virus_profile <- province_profile %>%
    left_join(virus_group_profile, by = "province") %>%
    left_join(virus_group_prevalence, by = "province")
  
  return(province_virus_profile)
}

