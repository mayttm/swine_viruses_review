# Define function to create and plot maps
create_sample_plot <- function(data, value_col, title, legend_name, china, data_type) {
  data_to_plot <- china %>%
    left_join(data, by = c("province_shp" = "province")) %>%
    mutate(temp_value = replace_na(.data[[value_col]], NA)) %>%
    mutate(
      temp_value = ifelse(province_shp %in% c("Taiwan", "Hong Kong", "Macau"), NA, temp_value)
    )
  
  map_plot <- ggplot(data = data_to_plot) +
    geom_sf(aes(fill = temp_value)) +
    scale_fill_viridis_c(
      option = "plasma",
      direction = -1,
      na.value = "grey85",
      name = legend_name,
      n.breaks = 5,
      limits = c(1, 70000)
    ) +
    # Keep same base size, specify base_family for consistent TIFF text rendering
    theme_minimal(base_size = 14, base_family = "sans") +
    labs(
      title = title,
      subtitle = paste(data_type, "detection")
    )
  
  return(map_plot)
}

