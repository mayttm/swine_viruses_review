canon <- function(x) {
  x <- as.character(x)
  x <- iconv(x, to = "ASCII//TRANSLIT")
  return(x)
}

normalize_adm1 <- function(x) {
  x <- trimws(as.character(x))
  x <- gsub("\\s*\\(.*\\)$", "", x)
  x <- gsub("\\s+(Province|Municipality|Special Administrative Region|Autonomous Region)$", "", x, ignore.case = TRUE)
  x <- gsub("^Xizang$", "Tibet", x, ignore.case = TRUE)
  x <- gsub("^Macao.*$", "Macau", x, ignore.case = TRUE)
  x <- gsub("^Hong\\s*Kong.*$", "Hong Kong", x, ignore.case = TRUE)
  return(x)
}

load_shapefile <- function() {
  shp_path <- "arcgis/shapefile/chn_admbnda_adm1_ocha_2020.shp"
  prov_col <- "ADM1_EN"
  china <- sf::st_read(shp_path, quiet = TRUE) %>%
    mutate(
      province_shp = normalize_adm1(.data[[prov_col]]),
      province_shp = dplyr::case_when(
        province_shp == "Guangxi Zhuang" ~ "Guangxi",
        province_shp == "Xinjiang Uygur" ~ "Xinjiang",
        province_shp == "Ningxia Hui" ~ "Ningxia",
        province_shp == "Nei Mongol" ~ "Inner Mongolia",
        province_shp == "Xizang" ~ "Tibet",
        province_shp == "Taiwan" ~ "Taiwan",
        province_shp == "Hong Kong" ~ "Hong Kong",
        province_shp == "Macau" ~ "Macau",
        TRUE ~ province_shp
      ),
      prov_key = canon(province_shp)
    )
  return(china)
}

## -- prepare data --

process_province_virus_data <- function(data, diag_type) {
  # Step 1: Clean data
  data <- data %>%
    mutate(
      virus = trimws(virus),
      province = trimws(province),
      positive_sample = as.numeric(positive_sample)  # Ensure positive_sample is numeric
    )
  
  if (diag_type == "molecular") {
    # Step 2: Calculate virus prevalence for molecular data
    virus_freq <- data %>%
      count(virus, name = "n") %>%
      mutate(freq = n / nrow(data))
    
    # Step 3: Identify viruses below threshold for molecular data
    low_freq_viruses <- virus_freq %>%
      filter(freq < 0.01) %>%  # 1% threshold
      pull(virus)
  } else {
    # No threshold for serological data
    low_freq_viruses <- character(0)
  }
  
  # Step 4: Group viruses
  data <- data %>%
    mutate(
      virus_group = case_when(
        virus %in% c("PCV2", "PCV3", "PCV4") ~ "PCV",
        virus %in% c("TTV", "TTSuV") ~ "TTV",
        virus %in% low_freq_viruses ~ "Others",
        TRUE ~ virus
      )
    )
  
  # Step 5: Process data
  virus_group_profile <- data %>%
    mutate(
      virus_group_mod = case_when(
        virus_group == "IAV" & grepl("H1N1", subtype_strain, ignore.case = TRUE) ~ "IAV_H1N1",
        virus_group == "PCV" & grepl("PCV2", virus, ignore.case = TRUE) ~ "PCV2",
        virus_group == "PCV" & grepl("PCV3", virus, ignore.case = TRUE) ~ "PCV3",
        TRUE ~ virus_group
      )
    ) %>%
    group_by(province, virus_group_mod) %>%
    summarise(positive_sample_group = sum(positive_sample, na.rm = TRUE), .groups = "drop") %>%
    pivot_wider(
      names_from = virus_group_mod,
      values_from = positive_sample_group,
      values_fill = list(positive_sample_group = 0)
    ) %>%
    select(-any_of(c("IAV", "PCV")))
  
  return(virus_group_profile)
}

