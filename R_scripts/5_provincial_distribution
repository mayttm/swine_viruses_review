create_combined_plot <- function(data, data_2, colors, china, output_file) {
  # Prepare the wide-format province dataset
  virus_cols <- setdiff(colnames(data), "province")
  data_long <- data %>%
    pivot_longer(cols = all_of(virus_cols), names_to = "virus", values_to = "count") %>%
    mutate(count = as.numeric(count)) %>%
    group_by(province) %>%
    mutate(perc = 100 * count / sum(count, na.rm = TRUE)) %>%
    ungroup()
  
  # Order viruses by total percentage across all provinces (descending)
  virus_order <- data_long %>%
    group_by(virus) %>%
    summarise(total_perc = sum(perc, na.rm = TRUE), .groups = "drop") %>%
    arrange(desc(total_perc)) %>%
    pull(virus)
  
  # Apply factor levels based on overall percentage
  data_long <- data_long %>%
    mutate(virus = factor(virus, levels = virus_order))
  
  # Use the province_profile dataset for province_positive
  province_positive <- data_2 %>%
    mutate(total_positive = as.numeric(total_positive)) %>%
    group_by(province) %>%
    summarise(total_positive = sum(total_positive, na.rm = TRUE), .groups = "drop") %>%
    mutate(prov_key = canon(province))
  
  # Merge with shapefile data
  china_map <- china %>%
    left_join(province_positive, by = c("province_shp" = "prov_key")) %>%
    mutate(total_positive = ifelse(is.na(total_positive), 0, total_positive)) %>%
    mutate(
      total_positive = ifelse(province_shp %in% c("Taiwan", "Hong Kong", "Macau"), NA, total_positive)
    )
  
  # Create donut chart
  donut_chart <- ggplot(data_long, aes(x = 2, y = perc, fill = virus)) +
    annotate("rect", xmin = 1.3, xmax = 1.7, ymin = -Inf, ymax = Inf, fill = "white", color = NA) +
    geom_bar(stat = "identity", width = 1, color = "white") +
    coord_polar(theta = "y") +
    xlim(0.5, 2.5) +
    facet_wrap(~ province, ncol = 6) +
    scale_fill_manual(values = colors) +
    theme_void() +
    theme(
      strip.text  = element_text(size = 16, family = "sans"),
      legend.position = "right",
      legend.title = element_text(size = 16, family = "sans"),
      legend.text  = element_text(size = 16, family = "sans"),
      plot.title   = element_text(size = 16, family = "sans"),
      plot.subtitle= element_text(size = 16, family = "sans"),
      plot.caption = element_text(size = 16, family = "sans"),
      plot.tag     = element_text(size = 16, family = "sans")
    ) +
    guides(fill = guide_legend(title = "Virus"))
  
  # China map
  china_plot <- ggplot(china_map) +
    geom_sf(aes(fill = total_positive), color = "black", size = 0.2) +
    geom_text_repel(
      aes(label = province_shp, geometry = geometry),
   #  color = ifelse(china_map$province_shp %in% c("Sichuan", "Guangxi", "Guangdong", "Henan"), "white", "black"),
      color = ifelse(china_map$province_shp %in% c("Shandong"), "white", "black"),
      stat = "sf_coordinates",
      min.segment.length = 0,
      size = 3
    ) +
    scale_fill_viridis_c(
      name = "Total positive samples by province",
      option = "C",
      direction = -1,
      na.value = "grey85",
      limits = c(0, 25000),
      guide = guide_colorbar(
        barheight = unit(5, "cm"),
        barwidth  = unit(0.5, "cm"),
        title.position = "top",
        title.hjust = 0,
        title.theme = element_text(
          size = 14, family = "sans",
          margin = margin(b = 15)
        )
      )
    ) +
    theme(
      panel.background = element_rect(fill = "white", color = NA),
      panel.grid.major = element_line(color = "grey80", size = 0.3),
      panel.grid.minor = element_line(color = "grey90", size = 0.2),
      legend.position = "right",
      legend.title = element_text(size = 16, family = "sans"),
      legend.text  = element_text(size = 16, family = "sans"),
      plot.margin  = margin(1, 1, 1, 1, "cm")
    ) +
    labs(fill = "Total positive samples by province")
  
  # Combine plots using patchwork
  layout <- "
  AAAAAAAAA
  AAAAAAAAA
  AAAAAAAAA
  BBBBBBBBB
  BBBBBBBBB
  BBBBBBBBB
  BBBBBBBBB
  "
  combined_plot <- china_plot + donut_chart +
    plot_layout(design = layout, guides = "collect") +
    plot_annotation(tag_levels = "A") &
    theme(
      legend.position = "right",
      plot.background = element_rect(fill = "white", color = NA),
      panel.spacing = unit(0.5, "lines"),
      text = element_text(family = "sans")
    )
  
  # Save combined plot - ggsave automatically detects format from extension
  ggsave(
    filename = output_file,
    plot = combined_plot,
    width = 15,
    height = 18,
    units = "in",
    dpi = 300,
    bg = "white"
  )
  
  return(combined_plot)
}

