###----------------- Province-Level Prevalence with Meta-Analysis -------------------###
library(tidyverse)
library(meta)
library(sf)
library(ggplot2)
library(viridis)
library(patchwork)
library(ragg)

## ============================================================================
## FUNCTION: Create Province Profile with Meta-Analysis
## ============================================================================
create_province_profile <- function(data) {
  
  total_pub_ID <- n_distinct(data$pub_ID)
  
  # Step 1: Basic descriptive statistics
  province_descriptive <- data %>%
    group_by(province) %>%
    summarise(
      frequency_pub_ID = n_distinct(pub_ID),
      sample_number = sum(sample_size, na.rm = TRUE),
      total_positive = sum(positive_sample, na.rm = TRUE),
      crude_prevalence = ifelse(sample_number > 0, total_positive / sample_number, NA),
      min_sampling_year = min(sampling_year, na.rm = TRUE),
      max_sampling_year = max(sampling_year, na.rm = TRUE),
      total_pub_ID = total_pub_ID,
      .groups = "drop"
    )
  
  # Step 2: Meta-analyzed pooled prevalence by province
  province_meta <- data %>%
    group_by(province) %>%
    filter(n() >= 2) %>%  # Need at least 2 observations for meta-analysis
    group_modify(~ {
      
      # Skip if insufficient data
      if (nrow(.x) < 2) return(tibble())
      
      tryCatch({
        # Perform meta-analysis with logit transformation
        meta_res <- metaprop(
          event = .x$positive_sample,
          n = .x$sample_size,
          studlab = .x$pub_ID,
          sm = "PLOGIT",
          method = "Inverse",
          method.tau = "REML",
          comb.random = TRUE,
          comb.fixed = FALSE,
          hakn = TRUE
        )
        
        # Extract pooled estimate and back-transform from logit
        tibble(
          pooled_prevalence = plogis(meta_res$TE.random),
          pooled_lower_CI = plogis(meta_res$lower.random),
          pooled_upper_CI = plogis(meta_res$upper.random),
          I2 = meta_res$I2,
          tau2 = meta_res$tau^2,
          n_studies_meta = meta_res$k
        )
      }, error = function(e) {
        # If meta-analysis fails, return NA
        tibble(
          pooled_prevalence = NA,
          pooled_lower_CI = NA,
          pooled_upper_CI = NA,
          I2 = NA,
          tau2 = NA,
          n_studies_meta = NA
        )
      })
    }) %>%
    ungroup()
  
  # Step 3: Merge descriptive and meta-analyzed results
  province_profile <- province_descriptive %>%
    left_join(province_meta, by = "province") %>%
    mutate(
      # Use pooled prevalence if available, otherwise crude
      average_prevalence = coalesce(pooled_prevalence, crude_prevalence),
      prevalence_type = case_when(
        !is.na(pooled_prevalence) ~ "Meta-analyzed",
        !is.na(crude_prevalence) ~ "Crude (single study)",
        TRUE ~ "No data"
      ),
      # Create formatted CI string
      prevalence_CI = ifelse(
        !is.na(pooled_lower_CI),
        paste0(round(average_prevalence, 3), " (", 
               round(pooled_lower_CI, 3), "-", 
               round(pooled_upper_CI, 3), ")"),
        as.character(round(average_prevalence, 3))
      )
    )
  
  return(province_profile)
}

