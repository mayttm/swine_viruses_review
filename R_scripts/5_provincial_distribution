## FUNCTION: Create Individual Prevalence Maps
## ============================================================================
create_prevalence_map_indv <- function(province_data, china, dataset_name, output_directory) {
  
  # Join province data with shapefile
  china_prevalence <- china %>%
    left_join(province_data, by = c("province_shp" = "province"))
  
  # Calculate summary statistics
  total_positive_sum <- sum(province_data$total_positive, na.rm = TRUE)
  total_sample_sum   <- sum(province_data$sample_number, na.rm = TRUE)
  overall_min_year   <- min(province_data$min_sampling_year, na.rm = TRUE)
  overall_max_year   <- max(province_data$max_sampling_year, na.rm = TRUE)
  num_studies        <- max(province_data$total_pub_ID, na.rm = TRUE)
  n_meta_provinces   <- sum(!is.na(province_data$pooled_prevalence))
  n_total_provinces  <- sum(!is.na(province_data$average_prevalence))
  
  # Extract virus name for title
  virus_label <- str_extract(dataset_name, "(?<=_)[^_]+$")
  
  # Create annotation label
  label_text <- paste(
    paste0("Average prevalence of ", virus_label),
    paste0("Number of studies: ", num_studies),
    paste0("Total positive/total samples: ", total_positive_sum, "/", total_sample_sum),
    paste0("Period: ", overall_min_year, "–", overall_max_year),
    paste0("Provinces: ", n_meta_provinces, " meta-analyzed, ", 
           n_total_provinces - n_meta_provinces, " crude"),
    "Prevalence estimated using random-effects meta-analysis where ≥2 studies available",
    sep = "\n"
  )
  
  # Get bounding box for annotation placement
  bbox  <- sf::st_bbox(china)
  xr    <- bbox$xmax - bbox$xmin
  yr    <- bbox$ymax - bbox$ymin
  x_off <- 0.975
  y_off <- 0.975
  
  # Create map
  map_plot <- ggplot(data = china_prevalence) +
    geom_sf(aes(fill = average_prevalence), color = "black", size = 0.2) +
    scale_fill_viridis_c(
      option = "plasma",
      direction = -1,
      name = "Prevalence",
      na.value = "grey85",
      limits = c(0, 1),
      labels = scales::percent_format(accuracy = 1)
    ) +
    theme_minimal() +
    theme(
      legend.position = c(0.95, 0.5),
      legend.justification = c(1, 0.5),
      legend.title = element_text(size = 11, family = "sans", face = "bold"),
      legend.text  = element_text(size = 10, family = "sans"),
      plot.margin  = margin(0.5, 0.5, 0.5, 0.5, unit = "cm"),
      legend.background = element_rect(fill = "white", color = "grey50", size = 0.2),
      panel.background = element_rect(fill = "white", color = NA),
      panel.grid.major = element_line(color = "grey90", size = 0.2),
      panel.grid.minor = element_blank(),
      text = element_text(family = "sans")
    ) +
    annotate(
      "text",
      x = bbox$xmin + xr * 0.02,
      y = bbox$ymin + yr * 0.02,
      label = label_text,
      hjust = 0, 
      vjust = 0,
      lineheight = 1.1,
      size = 3.2,
      family = "sans",
      color = "black"
    )

  ggsave(
    filename = file.path(output_directory, paste0("prev_map_", dataset_name, ".tiff")),
    plot = map_plot,
    width = 12,
    height = 10,
    units = "in",
    dpi = 600,
    device = ragg::agg_tiff,
    compression = "lzw",
    bg = "white"
  )
  
  # PDF
  ggsave(
    filename = file.path(output_directory, paste0("prev_map_", dataset_name, ".pdf")),
    plot = map_plot,
    width = 12,
    height = 10,
    units = "in"
  )
  
  # JPG
  ggsave(
    filename = file.path(output_directory, paste0("prev_map_", dataset_name, ".jpg")),
    plot = map_plot,
    width = 12,
    height = 10,
    units = "in",
    dpi = 600
  )
  
  return(map_plot)
}

