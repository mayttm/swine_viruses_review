library(dplyr)
library(ggplot2)
library(sf)
library(patchwork)
library(stringr)
library(viridis)
library(ragg) 

create_prevalence_maps <- function(province_data, china, dataset_name = NULL) {
  # Use provided dataset_name or fallback to object name
  if (is.null(dataset_name)) {
    dataset_name <- deparse(substitute(province_data))
  }
  
  # Determine virus name
  virus_name <- dataset_name %>%
    str_remove("^province_profile_") %>%
    str_remove("_mol$|_sero$")
  
  # Determine study type for title
  study_type <- if (str_detect(dataset_name, "_mol$")) "Molecular" else "Serological"
  
  # Append to title
  full_title <- paste0(virus_name, " (", study_type, ")")
  
  # Identify virus columns
  virus_groups <- province_data %>%
    select(starts_with("average_prevalence")) %>%
    colnames()
  
  if (length(virus_groups) == 0) {
    warning(paste("No columns starting with 'average_prevalence' found in", dataset_name))
    return(list())
  }
  
  map_list <- lapply(virus_groups, function(virus_group) {
    virus_prevalence_df <- province_data %>%
      select(province, matches(virus_group), frequency_pub_ID, total_positive, sample_number, min_sampling_year, max_sampling_year, total_pub_ID) %>%
      rename(prevalence = !!virus_group)
    
    if (nrow(virus_prevalence_df) == 0) return(NULL)
    
    china_prevalence <- china %>%
      left_join(virus_prevalence_df, by = c("province_shp" = "province"))
    
    total_positive_sum <- sum(virus_prevalence_df$total_positive, na.rm = TRUE)
    total_sample_sum   <- sum(virus_prevalence_df$sample_number, na.rm = TRUE)
    overall_min_year   <- min(province_data$min_sampling_year, na.rm = TRUE)
    overall_max_year   <- max(province_data$max_sampling_year, na.rm = TRUE)
    num_studies        <- max(virus_prevalence_df$total_pub_ID, na.rm = TRUE)
    
    label_text <- paste0(
      "Number of studies: ", num_studies, "\n",
      "Sum of total positive: ", total_positive_sum, "\n",
      "Sum of total samples: ", total_sample_sum, "\n",
      "Period: ", overall_min_year, "-", overall_max_year
    )
    
    ggplot(china_prevalence) +
      geom_sf(aes(fill = prevalence), color = "black", size = 0.2) +
      scale_fill_viridis_c(
        option = "plasma",
        direction = -1,
        name = "Average prevalence  ",
        na.value = "grey85",
        limits = c(0, 1),
        guide = guide_colorbar(barwidth = 15)
      ) +
      # Set base_family and base_size for consistent TIFF text rendering
      theme_minimal(base_family = "sans", base_size = 10) +
      theme(
        legend.position = "bottom",
        legend.title = element_text(size = 12),
        legend.text  = element_text(size = 12),
        plot.title   = element_text(size = 12),
        plot.subtitle= element_text(size = 12),
        panel.grid   = element_line(color = "grey90", size = 0.2)
      ) +
      labs(title = full_title, subtitle = label_text)
  })
  
  # Remove NULL maps
  map_list <- map_list[!sapply(map_list, is.null)]
  return(map_list)
}

