dataset_names <- ls(pattern = "^df_")

for(ds_name in dataset_names) {
  data <- get(ds_name)
  
  # Skip datasets with fewer than 5 publications
  if(n_distinct(data$pub_ID) < 5) {
    message(paste("⏩ Skipping", ds_name, "- fewer than 5 unique publications"))
    next
  }
  
  # Create province profile with meta-analysis
  province_profile <- create_province_profile(data)
  
  # Generate appropriate name
  virus_name <- str_remove(ds_name, "^df_molecular_|^df_serological_")
  suffix <- if(str_detect(ds_name, "molecular")) "_mol" else "_sero"
  new_name <- paste0("province_profile_", virus_name, suffix)
  
  # Assign to global environment
  assign(new_name, province_profile, envir = .GlobalEnv)
  
  # Summary message
  n_meta <- sum(!is.na(province_profile$pooled_prevalence))
  n_crude <- sum(is.na(province_profile$pooled_prevalence) & !is.na(province_profile$crude_prevalence))
  message(paste0("✅ Created ", new_name, 
                 " (", n_meta, " meta-analyzed, ", n_crude, " crude prevalence)"))
}

