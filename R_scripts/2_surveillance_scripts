# Function to create donut chart without labels
create_donut_chart <- function(data, var_name, title) {
  # Prepare data
  plot_data <- data %>%
    mutate(!!sym(var_name) := ifelse(is.na(!!sym(var_name)), "Not Reported", as.character(!!sym(var_name)))) %>%
    count(!!sym(var_name)) %>%
    arrange(desc(n)) %>%
    mutate(
      percentage = n / sum(n) * 100,
      !!sym(var_name) := factor(!!sym(var_name), levels = !!sym(var_name))
    )
  
  # Create plot without any labels
  p <- ggplot(plot_data, aes(x = 2, y = n, fill = !!sym(var_name))) +
    geom_bar(stat = "identity", width = 1, color = "white", size = 0.8) +
    coord_polar(theta = "y", start = 0) +
    xlim(0.5, 2.5) +
    theme_void() +
    theme(
      plot.title = element_text(hjust = 0.5, size = 13, face = "bold",
                                margin = margin(b = 10)),
      plot.background = element_rect(fill = "white", color = NA),
      panel.background = element_rect(fill = "white", color = NA),
      legend.position = "right",
      legend.title = element_blank(),
      legend.text = element_text(size = 8.5),
      legend.key.size = unit(0.7, "cm"),
      legend.background = element_rect(fill = "white", color = NA),
      plot.margin = margin(10, 5, 10, 5) ,
      aspect.ratio = 1
    ) +
    labs(title = title) +
    scale_fill_manual(
      values = colorRampPalette(c("#8DD3C7", "#FFFFB3", "#BEBADA", "#FB8072",
                                  "#80B1D3", "#FDB462", "#B3DE69", "#FCCDE5",
                                  "#D9D9D9", "#BC80BD", "#CCEBC5", "#FFED6F"))(
                                    nrow(plot_data)),
      labels = function(x) {
        idx <- match(x, plot_data[[var_name]])
        paste0(str_wrap(x, 20), " (",
               sprintf("%.1f%%", plot_data$percentage[idx]), ")")
      }
    )
  
  return(p)
}

create_virus_donut_chart <- function(data, var_name, title) {
  # Prepare data
  plot_data <- data %>%
    mutate(!!sym(var_name) := ifelse(is.na(!!sym(var_name)), "Not Reported", as.character(!!sym(var_name)))) %>%
    count(!!sym(var_name)) %>%
    arrange(desc(n)) %>%
    mutate(
      percentage = n / sum(n) * 100,
      !!sym(var_name) := factor(!!sym(var_name), levels = !!sym(var_name))
    )
  
  # Use pathogen_colors for viruses
  virus_names <- as.character(plot_data[[var_name]])
  fill_colors <- pathogen_colors[virus_names]
  # For any viruses not in pathogen_colors, assign a default color
  fill_colors[is.na(fill_colors)] <- "grey67"
  names(fill_colors) <- virus_names
  
  # Create plot without any labels
  p <- ggplot(plot_data, aes(x = 2, y = n, fill = !!sym(var_name))) +
    geom_bar(stat = "identity", width = 1, color = "white", size = 0.8) +
    coord_polar(theta = "y", start = 0) +
    xlim(0.5, 2.5) +
    theme_void() +
    theme(
      plot.title = element_text(hjust = 0.5, size = 13, face = "bold",
                                margin = margin(b = 10)),
      plot.background = element_rect(fill = "white", color = NA),
      panel.background = element_rect(fill = "white", color = NA),
      legend.position = "right",
      legend.title = element_blank(),
      legend.text = element_text(size = 8.5),
      legend.key.size = unit(0.7, "cm"),
      legend.background = element_rect(fill = "white", color = NA),
      plot.margin = margin(10, 5, 10, 5),
      aspect.ratio = 1
    ) +
    labs(title = title) +
    scale_fill_manual(
      values = fill_colors,
