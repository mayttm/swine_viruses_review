    all_summary_province <- rbind(all_summary_province, data.frame(
      dataset = str_replace(dataset_name, "^df_", ""),
      province = "N/A",
      n_studies = 0,
      I2 = NA,
      required_studies = NA,
      meets_individual_criteria = "No",
      n_categories_meeting_criteria = 0,
      meets_overall_criteria = "No",
      reason_excluded = "Missing required columns",
      stringsAsFactors = FALSE
    ))
    next
  }
  
  # Filter data: remove NA/blank province and require sample_size >= 30
  data_filtered <- data %>%
    filter(!is.na(province),
           str_trim(province) != "",
           sample_size >= 30,
           diag_test != "Virus_isolation")
  
  if (nrow(data_filtered) == 0) {
    message(paste0("⚠ Skipping ", dataset_name, " — no valid province"))
    all_summary_province <- rbind(all_summary_province, data.frame(
      dataset = str_replace(dataset_name, "^df_", ""),
      province = "N/A",
      n_studies = 0,
      I2 = NA,
      required_studies = NA,
      meets_individual_criteria = "No",
      n_categories_meeting_criteria = 0,
      meets_overall_criteria = "No",
      reason_excluded = "No valid province data",
      stringsAsFactors = FALSE
    ))
    next
  }
  
  # Calculate prevalence
  data_filtered <- data_filtered %>% mutate(prevalence = positive_sample / sample_size)
  
  # ✅ Calculate I² for ALL provinces (before filtering)
  province_stats <- data.frame(
    province = character(),
    n_studies = integer(),
    I2 = numeric(),
    stringsAsFactors = FALSE
  )
  
  for(prov in unique(data_filtered$province)) {
    prov_data <- data_filtered %>% filter(province == prov)
    n_pubs <- n_distinct(prov_data$pub_ID)
    
    # ✅ Require at least 3 independent studies (pub_IDs) per category
    if(n_pubs >= 3) {
      tryCatch({
        temp_meta <- metaprop(
          event = positive_sample,
          n = sample_size,
          studlab = paste(pub_ID),
          data = prov_data,
          sm = "PLOGIT",
          method = "Inverse",
          method.tau = "REML",
          comb.fixed = FALSE,
          comb.random = TRUE
        )
        province_stats <- rbind(province_stats, data.frame(
          province = prov,
          n_studies = n_pubs,  # ✅ Count pub_IDs, not rows
          I2 = temp_meta$I2,
          stringsAsFactors = FALSE
        ))
      }, error = function(e) {
        province_stats <- rbind(province_stats, data.frame(
          province = prov,
          n_studies = n_pubs,
          I2 = NA,
          stringsAsFactors = FALSE
        ))
        message(paste0("⚠ Could not calculate I² for ", prov, " in ", dataset_name))
      })
    } else {
      # ✅ Record provinces with insufficient pub_IDs
      province_stats <- rbind(province_stats, data.frame(
        province = prov,
        n_studies = n_pubs,
        I2 = NA,
        stringsAsFactors = FALSE
      ))
    }
  }
  
  # ✅ Apply criteria based on I²
  province_stats <- province_stats %>%
    mutate(
      required_studies = ifelse(is.na(I2), 5, ifelse(I2 < 50, 3, 5)),
      meets_individual_criteria = n_studies >= required_studies
    )
  
  # Count how many categories meet criteria
  n_categories_meeting <- sum(province_stats$meets_individual_criteria, na.rm = TRUE)
  
  # Determine overall eligibility
  overall_meets <- n_categories_meeting >= 2
  
  # Determine reason for exclusion if not meeting criteria
  if(!overall_meets) {
    if(n_categories_meeting == 0) {
      reason <- "No province categories meet study number criteria"
    } else if(n_categories_meeting == 1) {
      reason <- "Only 1 province category meets criteria (need ≥2)"
    } else {
      reason <- "Other criteria not met"
    }
  } else {
    # Check for zero-event subgroups in eligible categories
    valid_provinces <- province_stats %>%
      filter(meets_individual_criteria) %>%
      pull(province)
    
    data_check <- data_filtered %>% filter(province %in% valid_provinces)
    
    zero_event <- data_check %>%
      group_by(province) %>%
      summarise(total_events = sum(positive_sample)) %>%
      filter(total_events == 0)
    
    if(nrow(zero_event) > 0) {
      reason <- paste0("Zero events in categories: ", paste(zero_event$province, collapse = ", "))
      overall_meets <- FALSE
    } else {
      reason <- "Meets all criteria"
    }
  }
  
  # ✅ Store ALL statistics for this dataset
  temp_summary <- province_stats %>%
    mutate(
      dataset = str_replace(dataset_name, "^df_", ""),
      n_categories_meeting_criteria = n_categories_meeting,
      meets_overall_criteria = ifelse(overall_meets, "Yes", "No"),
      reason_excluded = reason,
      meets_individual_criteria = ifelse(meets_individual_criteria, "Yes", "No")
    ) %>%
    select(dataset, province, n_studies, I2, required_studies,
           meets_individual_criteria, n_categories_meeting_criteria,
           meets_overall_criteria, reason_excluded)
  
  all_summary_province <- rbind(all_summary_province, temp_summary)
  
  # ✅ Continue with analysis ONLY if criteria met
  if(!overall_meets) {
    message(paste0("⚠ Skipping ", dataset_name, " — ", reason))
    next
  }
  
  # Filter to eligible provinces
  valid_provinces <- province_stats %>%
    filter(meets_individual_criteria) %>%
    pull(province)
  
  data_filtered <- data_filtered %>% filter(province %in% valid_provinces)
  
  # Keep provinces with total sample size > 1
  size_counts <- data_filtered %>%
    group_by(province) %>%
    summarise(total_sample = sum(sample_size), .groups = "drop")
  
  valid_provinces <- size_counts %>%
    filter(total_sample > 1) %>%
    pull(province)
  
  data_filtered <- data_filtered %>% filter(province %in% valid_provinces)
  
  # ✅ Set reference category: province with largest sample size
  province_sizes <- data_filtered %>%
    group_by(province) %>%
    summarise(total_n = sum(sample_size), .groups = "drop") %>%
    arrange(desc(total_n))
  
  ref_province <- province_sizes$province[1]
  
  # Relevel province to set reference
  data_filtered <- data_filtered %>%
    mutate(province = factor(province, levels = c(ref_province, setdiff(unique(province), ref_province))))
  
  message(paste0("ℹ Reference category for ", dataset_name, ": ", ref_province,
                 " (n=", province_sizes$total_n[1], ", largest sample size)"))
  message(paste0("ℹ Included provinces: ", paste(unique(data_filtered$province), collapse = ", ")))
  
  # Create export folder
  export_path <- "figures/subgroup/or_province/prevalence/"
  dir.create(export_path, recursive = TRUE, showWarnings = FALSE)
  
  tryCatch({
    # ✅ Run subgroup meta-analysis
    meta_res <- metaprop(
      event = positive_sample,
      n = sample_size,
      studlab = paste(pub_ID),
      data = data_filtered,
      sm = "PLOGIT",
      method = "Inverse",
      method.tau = "REML",
      comb.fixed = FALSE,
      comb.random = TRUE,
      byvar = province,
      print.byvar = TRUE,
      overall = FALSE
    )
    
    # ✅ Extract Q-test statistics for subgroup differences
    q_between <- meta_res$Q.b.random
    q_df <- meta_res$df.Q.b
    q_pval <- meta_res$pval.Q.b.random
    n_subgroups <- length(unique(data_filtered$province))
    
    # Determine significance
    interpretation <- ifelse(is.na(q_pval), "Could not calculate", 
                             ifelse(q_pval < 0.001, "Highly significant difference (p<0.001)",
                                    ifelse(q_pval < 0.01, "Very significant difference (p<0.01)",
                                           ifelse(q_pval < 0.05, "Significant difference (p<0.05)",
                                                  "No significant difference (p≥0.05)"))))
    
    # Store Q-test results
    q_test_province <- rbind(q_test_province, data.frame(
      dataset = str_replace(dataset_name, "^df_", ""),
      subgroup_variable = "province",
      reference_category = ref_province,
      n_subgroups = n_subgroups,
      Q_between = round(q_between, 3),
      df = q_df,
      p_value = round(q_pval, 4),
      interpretation = interpretation,
      stringsAsFactors = FALSE
    ))
    
    message(paste0("ℹ Q-test: Q=", round(q_between, 2), ", df=", q_df, 
                   ", p=", round(q_pval, 4), " — ", interpretation))
    
    # Clean title for plotting
    plot_title <- dataset_name %>%
      str_replace("^df_", "") %>%
      str_replace_all("_", " ")
    
    # Zebra-style shading per pub_ID
    shade_groups <- as.numeric(factor(data_filtered$pub_ID)) %% 2 != 0
    
    # Dynamic sizing
    n_studies <- nrow(data_filtered)
    cex_value <- min(0.9, 800 / n_studies + 20)
    mar_bottom <- max(2, 2 + n_studies * 0.5)
    mar_left <- max(1, 1 + n_studies * 0.05)
    png_width <- 4000
