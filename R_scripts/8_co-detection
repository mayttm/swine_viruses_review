# Function to create paneled UpSet plots for dual, triple, and quadruple infections
create_coinfection_panel <- function(data_coinf) {
  
  library(ComplexHeatmap)
  library(grid)
  
  # Prepare typed data
  data_coinf_typed <- data_coinf %>%
    rowwise() %>%
    mutate(
      viruses = list(na.omit(str_squish(c_across(virus_1:virus_4)))),
      viruses = list(viruses[viruses != ""]),
      n_viruses = length(viruses),
      infection_type = case_when(
        n_viruses == 2 ~ "Dual",
        n_viruses == 3 ~ "Triple",
        n_viruses == 4 ~ "Quadruple",
        TRUE ~ "Other"
      )
    ) %>%
    ungroup()
  
  # Create list to store plots
  plot_list <- list()
  
  # Generate plots for each type
  for (type in c("Dual", "Triple", "Quadruple")) {
    virus_list_type <- data_coinf_typed %>%
      filter(infection_type == type) %>%
      pull(viruses)
    
    if (length(virus_list_type) > 0) {
      # Create binary matrix
      all_viruses_type <- unique(unlist(virus_list_type))
      upset_matrix_type <- matrix(0, nrow = length(virus_list_type), ncol = length(all_viruses_type))
      colnames(upset_matrix_type) <- all_viruses_type
      
      for (i in seq_along(virus_list_type)) {
        upset_matrix_type[i, virus_list_type[[i]]] <- 1
      }
      
      m_type <- make_comb_mat(upset_matrix_type)
      
      # Create UpSet plot
      upset_plot_type <- UpSet(
        m_type,
        set_order = order(set_size(m_type), decreasing = TRUE),
        comb_order = order(comb_size(m_type), decreasing = TRUE),
        top_annotation = HeatmapAnnotation(
          "Intersection Size" = anno_barplot(
            comb_size(m_type),
            border = FALSE,
            gp = gpar(fill = "#1F78B4"),
            height = unit(2.5, "cm"),
            add_numbers = TRUE,
            numbers_gp = gpar(fontsize = 8, col = "black")
          ),
          annotation_name_side = "left",
          annotation_name_rot = 90,
          annotation_name_gp = gpar(fontsize = 9)
        ),
        right_annotation = rowAnnotation(
          "Set Size" = anno_barplot(
            set_size(m_type),
            border = FALSE,
            gp = gpar(fill = "#B22222"),
            width = unit(2.5, "cm"),
            add_numbers = TRUE,
            numbers_gp = gpar(fontsize = 8, col = "black")
          ),
          annotation_name_gp = gpar(fontsize = 9)
        ),
        row_names_gp = gpar(fontsize = 9),
        column_title = paste0(type, " co-detections (n=", length(virus_list_type), ")"),
        column_title_gp = gpar(fontsize = 12, fontface = "bold")
      )
      
      plot_list[[type]] <- upset_plot_type
    } else {
      cat(paste0("Warning: No ", type, " infections found\n"))
      plot_list[[type]] <- NULL
    }
  }
  
  return(plot_list)
}

# Function to combine plots into a panel with adjustable layout
create_combined_coinf_panel <- function(plot_list, output_prefix,
                                        width = 12, height = 16, dpi = 300) {
  
  # Filter out NULL plots
  valid_plots <- plot_list[!sapply(plot_list, is.null)]
  if(length(valid_plots) == 0) {
    cat("⚠ No valid plots to combine\n")
    return(NULL)
  }
  
  n_plots <- length(valid_plots)
  
  # Layout: 3 rows, 1 column (equal heights)
  layout_matrix <- rbind(
    c(1),
    c(2),
    c(3)
  )
  
  # Adjust heights for each panel (you can modify these)
  heights <- c(1.5, 1, 0.8)
  
  # Function to draw the panel
  draw_panel <- function() {
    pushViewport(viewport(layout = grid.layout(
      nrow = nrow(layout_matrix),
      ncol = ncol(layout_matrix),
      heights = unit(heights, "null")
    )))
    
    plot_idx <- 1
    for (i in 1:nrow(layout_matrix)) {
      for (j in 1:ncol(layout_matrix)) {
        if (layout_matrix[i, j] > 0 && layout_matrix[i, j] <= n_plots) {
          pushViewport(viewport(layout.pos.row = i, layout.pos.col = j))
          draw(valid_plots[[plot_idx]], newpage = FALSE)
          upViewport()
          plot_idx <- plot_idx + 1
        }
      }
    }
    
    upViewport()
  }
  
  # Save as PDF
  pdf(paste0(output_prefix, ".pdf"), width = width, height = height)
  draw_panel()
  dev.off()
  
  # Save as TIFF
  tiff(paste0(output_prefix, ".tiff"),
       width = width * dpi, height = height * dpi, units = "px",
       res = dpi, compression = "lzw")
  draw_panel()
  dev.off()
  
  # Save as JPEG
  jpeg(paste0(output_prefix, ".jpg"),
       width = width * dpi, height = height * dpi, units = "px",
       res = dpi, quality = 95)
  draw_panel()
  dev.off()
  
  cat("\n=== Panel Created Successfully ===\n")
  cat(paste0("Files saved as:\n"))
  cat(paste0("  - ", output_prefix, ".pdf\n"))
  cat(paste0("  - ", output_prefix, ".tiff\n"))
  cat(paste0("  - ", output_prefix, ".jpg\n"))
  cat(paste0("Layout: ", nrow(layout_matrix), " rows × ", ncol(layout_matrix), " columns\n"))
  cat(paste0("Heights: ", paste(heights, collapse = ", "), "\n"))
  
  return(invisible(NULL))
}

# Usage:
# Step 1: Create individual plots
coinfection_plots <- create_coinfection_panel(data_coinf)

# Step 2: Combine into panel with custom layout
create_combined_coinf_panel(
  plot_list = coinfection_plots,
  output_prefix = "figures/Figure_11_co-detection",
  width = 10,
  height = 14,
  dpi = 300
)
