library(dplyr)
library(tidyr)
library(readr)
library(stringr)
library(ComplexHeatmap)
library(ggplot2)

data_coinf <- read.csv("data/data_coinfection.csv", stringsAsFactors = FALSE)
try(Sys.setlocale("LC_ALL", "en_US.UTF-8"), silent = TRUE)

data_coinf <- data_coinf %>%
  mutate(across(where(is.character), ~ enc2utf8(.)))

data_coinf <- data_coinf %>%
  filter(province != "Multiple")

# Clean and standardize virus names
data_coinf <- data_coinf %>%
  mutate(across(virus_1:virus_4, ~ str_squish(.) %>% na_if(""))) %>%
  # Combine TTSuV1 and TTSuV2 into TTSuV
  mutate(across(virus_1:virus_4, ~ case_when(
    . %in% c("TTSuV1", "TTSuV2") ~ "TTSuV",
    TRUE ~ .
  ))) %>%
  # Combine PPV2, PPV6, PPV7 into PPV
  mutate(across(virus_1:virus_4, ~ case_when(
    . %in% c("PPV2", "PPV6", "PPV7") ~ "PPV",
    TRUE ~ .
  )))

# After combining, we need to remove duplicates within each row
# (e.g., if someone had both TTSuV1 and TTSuV2, now they have TTSuV twice)
data_coinf <- data_coinf %>%
  rowwise() %>%
  mutate(
    # Get unique viruses for each row
    unique_viruses = list(unique(na.omit(c_across(virus_1:virus_4)))),
    unique_viruses = list(unique_viruses[unique_viruses != ""]),
    # Reassign to virus columns
    virus_1 = ifelse(length(unique_viruses) >= 1, unique_viruses[[1]], NA_character_),
    virus_2 = ifelse(length(unique_viruses) >= 2, unique_viruses[[2]], NA_character_),
    virus_3 = ifelse(length(unique_viruses) >= 3, unique_viruses[[3]], NA_character_),
    virus_4 = ifelse(length(unique_viruses) >= 4, unique_viruses[[4]], NA_character_)
  ) %>%
  ungroup() %>%
  select(-unique_viruses)

# Now create coinfection_group with cleaned data
data_coinf <- data_coinf %>%
  mutate(across(virus_1:virus_4, ~ str_squish(.) %>% na_if(""))) %>%
  unite("coinfection_group", virus_1:virus_4, sep = "_", na.rm = TRUE,
        remove = FALSE) %>%
  mutate(
    coinfection_group = gsub("_{2,}", "_", coinfection_group),
    coinfection_group = gsub("^_|_$", "", coinfection_group)
  ) %>%
  filter(coinfection_group != "")

###---- summarize data -----
coinf_unique_pub_ID <- data_coinf %>% distinct(pub_ID) %>% nrow()
coinf_pub_ID_frequency <- data_coinf %>%
  filter(!is.na(pub_ID), pub_ID != "") %>%
  count(pub_ID, name = "frequency") %>%
  arrange(desc(frequency))

coinf_top5_viruses <- data_coinf %>%
  select(virus_1:virus_4) %>%
  pivot_longer(everything(), names_to = "virus_col", values_to = "virus") %>%
  mutate(virus = stringr::str_squish(virus)) %>%
  filter(!is.na(virus), virus != "") %>%
  count(virus, name = "frequency") %>%
  arrange(desc(frequency)) %>%
  slice_head(n = 5)

coinf_top5_coinf_group <- data_coinf %>%
  filter(!is.na(coinfection_group), coinfection_group != "") %>%
  count(coinfection_group, name = "frequency") %>%
  arrange(desc(frequency)) %>%
  mutate(percent = frequency / sum(frequency)) %>%
  slice_head(n = 5)

coinf_unique_pub_ID
head(coinf_pub_ID_frequency, 10)
coinf_top5_viruses
coinf_top5_coinf_group

## ------------------------ PREPARING PROFILE DATA -------------------------- ##
coinf_province_coinf_year <- data_coinf %>%
  group_by(province, coinfection_group, sampling_year) %>%
  summarise(
    sample_number = sum(sample_size, na.rm = TRUE),
    total_positive = sum(positive_sample, na.rm = TRUE),
    prevalence = ifelse(sample_number > 0, total_positive / sample_number, NA),
    .groups = "drop"
  )

coinf_province_coinf_summary <- coinf_province_coinf_year %>%
  mutate(
    year_prev = paste0(sampling_year, "(", round(prevalence * 100, 1), "%)")
  ) %>%
  group_by(province, coinfection_group) %>%
  summarise(
    coinfection_profile = paste(year_prev, collapse = ", "),
    .groups = "drop"
  )

coinf_province_coinf_wide <- coinf_province_coinf_summary %>%
  pivot_wider(
    id_cols = province,
    names_from = coinfection_group,
    values_from = coinfection_profile,
    values_fill = "No data"
  )

coinf_province_coinf_stats <- data_coinf %>%
  group_by(province) %>%
  summarise(
    total_coinfection_types = n_distinct(coinfection_group),
    total_coinfection_cases = sum(positive_sample, na.rm = TRUE),
    .groups = "drop"
  )

coinf_province_coinf_profile <- coinf_province_coinf_stats %>%
  left_join(coinf_province_coinf_wide, by = "province")

write_excel_csv(coinf_province_coinf_profile,
                "arcgis/gis_data/arcgis_province_coinfection_year.csv")

