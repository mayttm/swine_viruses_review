# Function to create a map for a given year's outbreak dataset
map_yearly_outbreak <- function(year_df, shapefile_sf, year) {
  
  map_df <- shapefile_sf %>%
    left_join(year_df, by = c("province_shp" = "province"))
  
  # Pivot all virus columns (everything except 'province_shp' or other shapefile columns)
  virus_cols <- setdiff(names(year_df), "province")  # virus columns only
  map_long <- map_df %>%
    pivot_longer(
      cols = all_of(virus_cols),
      names_to = "virus",
      values_to = "prevalence"
    ) %>%
    filter(prevalence > 0)
  
  ggplot() +
    geom_sf(data = shapefile_sf, fill = "grey90", color = "white") +
    geom_sf(data = map_long, aes(fill = virus), color = "black") +
    scale_fill_manual(values = pathogen_molec_colors, na.value = "grey80") +
    ggtitle(paste("Outbreaks in", year, (province))) +
    theme_minimal(base_size = 12, title.size = 12) +
    theme(legend.title = element_blank())
}

library(ggplot2)
