map_yearly_outbreak <- function(year_df, shapefile_sf, year) {
  
  year_df <- as.data.frame(year_df)
  
  # Pivot longer
  year_long <- year_df %>%
    pivot_longer(
      cols = -province,
      names_to = "virus",
      values_to = "prevalence"
    ) %>%
    filter(prevalence > 0) %>%
    group_by(province) %>%
    arrange(province, virus) %>%   # order viruses for consistent layering
    mutate(rank = row_number()) %>%
    ungroup()
  
  map_long <- shapefile_sf %>%
    inner_join(year_long, by = c("province_shp" = "province")) %>%
    st_as_sf()
  
  first_virus <- map_long %>% filter(rank == 1)
  
  stripe_viruses <- map_long %>% filter(rank > 1)
  
  provinces_with_outbreak <- unique(map_long$province_shp) %>% paste(collapse = ", ")
  
  ggplot() +
    geom_sf(data = shapefile_sf, fill = "grey90", color = "grey30") +
    geom_sf(data = first_virus, aes(fill = virus), color = "black") +
    geom_sf_pattern(
      data = stripe_viruses,
      aes(pattern_fill = virus),
      fill = NA,
      pattern = "stripe",
      color = "black",
      pattern_density = 0.5,
      pattern_spacing = 0.02,
      pattern_angle = 45
    ) +
    scale_fill_manual(values = pathogen_molec_colors, na.value = "grey80") +
    scale_pattern_fill_manual(values = pathogen_molec_colors) +
    ggtitle(paste0("Outbreaks in ", year, " (", provinces_with_outbreak, ")")) +
    theme_minimal(base_size = 14) +
    theme(
      legend.title = element_text(size = 14, family = "sans"),
      plot.title = element_text(size = 14, family = "sans")
    )
}

