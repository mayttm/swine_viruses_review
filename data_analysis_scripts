## ----------------- creating datasets for meta-analysis -------------------- ##

library(dplyr)

columns_to_keep <- c("pub_ID", "region", "province", "pig_type", "health_status", 
                     "sample_type", "sampling_year", "positive_sample", "season",
                     "subtype_strain", "strain_detail", "sample_size", "diag_test", 
                     "diag_test_details", "co.infection", "farm_size", "vaccination", 
                     "independent_sample", "remarks")

# Get unique combinations of diag_type and virus
unique_combos <- data_surv_single %>%
  distinct(diag_type, virus)

# Loop through each combination and create datasets in the workspace
for (i in seq_len(nrow(unique_combos))) {
  
  diag_val <- unique_combos$diag_type[i]
  virus_val <- unique_combos$virus[i]
  
  # Special handling for IAV: create separate datasets for each subtype_strain
  if (virus_val == "IAV") {
    
    # Get unique subtype strains for IAV
    subtype_list <- data_surv_single %>%
      filter(diag_type == diag_val, virus == virus_val) %>%
      pull(subtype_strain) %>%
      unique() %>%
      na.omit()
    
    # Loop through each subtype and create separate datasets
    for (subtype in subtype_list) {
      
      subset_data <- data_surv_single %>%
        filter(diag_type == diag_val, virus == virus_val, subtype_strain == subtype) %>%
        select(all_of(columns_to_keep))
      
      # Create clean object name: df_diag_virus_subtype
      object_name <- paste0("df_", 
                            gsub("[^A-Za-z0-9]+", "_", diag_val), "_",
                            gsub("[^A-Za-z0-9]+", "_", virus_val), "_",
                            gsub("[^A-Za-z0-9]+", "_", subtype))
      
      # Assign to workspace
      assign(object_name, subset_data, envir = .GlobalEnv)
    }
    
  } else {
    # For all other viruses, create one dataset per diag_type + virus
    subset_data <- data_surv_single %>%
      filter(diag_type == diag_val, virus == virus_val) %>%
      select(all_of(columns_to_keep))
    
    object_name <- paste0("df_", 
                          gsub("[^A-Za-z0-9]+", "_", diag_val), "_",
                          gsub("[^A-Za-z0-9]+", "_", virus_val))
    
    assign(object_name, subset_data, envir = .GlobalEnv)
  }
}

