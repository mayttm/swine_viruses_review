  data <- get(dataset_name)
  
  # Check required columns
  if(!all(c("season", "positive_sample", "sample_size", "pub_ID", "sampling_year", "diag_test_details") %in% colnames(data))) {
    message(paste0("⚠ Skipping ", dataset_name, " — missing required columns"))
    next
  }
  
  # Filter data: remove NA/blank season and require sample_size >= 30
  data <- data %>%
    filter(!is.na(season),
           str_trim(season) != "",
           sample_size >= 20)
  
  if (nrow(data) == 0) {
    message(paste0("⚠ Skipping ", dataset_name, " — no valid season"))
    next
  }
  
  # Calculate prevalence
  data <- data %>% mutate(prevalence = positive_sample / sample_size)
  
  # Keep seasons with >= 2 publications
  pub_counts <- data %>%
    group_by(season) %>%
    summarise(n_pub = n_distinct(pub_ID), .groups = "drop")
  
  valid_seasons <- pub_counts %>%
    filter(n_pub > 2) %>%
    pull(season)
  
  data <- data %>% filter(season %in% valid_seasons)
  
  # Keep seasons with total sample size > 1
  size_counts <- data %>%
    group_by(season) %>%
    summarise(total_sample = sum(sample_size), .groups = "drop")
  
  valid_seasons <- size_counts %>%
    filter(total_sample > 1) %>%
    pull(season)
  
  data <- data %>% filter(season %in% valid_seasons)
  
  # Check minimum seasons required
  if(length(unique(data$season)) < 2) {
    message(paste0("⚠ Skipping ", dataset_name, " — not enough seasons"))
    next
  }
  
  # Check for zero-event subgroups
  zero_event <- data %>%
    group_by(season) %>%
    summarise(total_events = sum(positive_sample)) %>%
    filter(total_events == 0)
  
  if(nrow(zero_event) > 0) {
    message(paste0("⚠ Skipping ", dataset_name, " — zero events in seasons: ",
                   paste(zero_event$season, collapse = ", ")))
    next
  }
  
  # Create export folder
  export_path <- "figures/or_season/prevalence/"
  dir.create(export_path, recursive = TRUE, showWarnings = FALSE)
  
  tryCatch({
    # ✅ Run subgroup meta-analysis — separate pooled prevalence per season
    meta_res <- metaprop(
      event = positive_sample,
      n = sample_size,
      studlab = paste(pub_ID),
      data = data,
      sm = "PLOGIT",          # Pooled prevalence using logit transformation
      method = "Inverse",
      method.tau = "DL",
      comb.fixed = FALSE,
      comb.random = TRUE,
      byvar = season,         # Subgroup by season
      print.byvar = TRUE,     # Ensures weights are normalized per subgroup
      overall = FALSE         # ✅ Prevents global pooled prevalence (per season only)
    )
    
    # Clean title for plotting
    plot_title <- dataset_name %>%
      str_replace("^df_", "") %>%
      str_replace_all("_", " ")
    
    # Zebra-style shading per pub_ID
    shade_groups <- as.numeric(factor(data$pub_ID)) %% 2 != 0
    
    # Dynamic sizing
    n_studies <- nrow(data)
    cex_value <- min(0.9, 800 / n_studies + 20)
    mar_bottom <- max(2, 2 + n_studies * 0.5)
    mar_left <- max(1, 1 + n_studies * 0.05)
    png_width <- 4000
    png_height <- max(2400, n_studies * 90)
    
    # Export forest plot
    png_file <- paste0(export_path, "or_", dataset_name, ".png")
    png(filename = png_file, width = png_width, height = png_height, res = 300)
    par(mar = c(mar_bottom, mar_left, 4, 10))
    
    forest(
      meta_res,
      sortvar = data$sampling_year,
      smlab = "Pooled Prevalence",
      leftcols = c("studlab", "diag_test_details", "sampling_year", "n"),
      leftlabs = c("Study", "Diagnostic Test", "Sampling Year", "Sample Size"),
      rightcols = c("effect", "ci", "w.random"),
      rightlabs = c("Prevalence", "95% CI", "Weight"),
      comb.fixed = FALSE,
      comb.random = TRUE,
      overall = FALSE,         # Removes combined total, keeps per season
      text.random = "Pooled Prevalence",
      prediction = TRUE,
      col.predict = "darkblue",
      col.diamond = "red",      
      col.diamond.lines = "black",
      shade = shade_groups,
      print.byvar = TRUE,
      print.tau2 = TRUE,
      print.I2 = TRUE,
      xlab = "Prevalence",
      xlim = c(0, 1),
      main = paste("Forest Plot -", plot_title, "(PR)"),
      just = "center",
      cex = cex_value,
      spacing = 1.15
    )
    
    dev.off()
    message(paste0("✅ Forest plot created for ", dataset_name, " (", n_studies, " studies)"))
    
  }, error = function(e) {
    message(paste0("⚠ Meta-analysis failed for ", dataset_name, ": ", e$message))
  })
}

