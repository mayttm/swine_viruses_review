    group_by(province, period) %>%
    summarise(total_samples = sum(sample_size, na.rm = TRUE), .groups = "drop") %>%
    pivot_wider(
      names_from = period,
      values_from = total_samples,
      values_fill = 0
    ) %>%
    arrange(province)
  
  return(prov_year_profile)
}

