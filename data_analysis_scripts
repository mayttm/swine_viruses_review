# Function to generate outbreak datasets per year
create_yearly_outbreak <- function(df) {
  years <- sort(unique(df$sampling_year))
  yearly_list <- list()
  
  for (yr in years) {
    df_year <- df %>%
      filter(sampling_year == yr) %>%
      group_by(province, virus) %>%
      summarise(
        avg_prevalence = sum(positive_sample, na.rm = TRUE) / sum(sample_size, na.rm = TRUE),
        .groups = "drop"
      ) %>%
      pivot_wider(
        names_from = virus,
        values_from = avg_prevalence,
        values_fill = 0
      )
    yearly_list[[as.character(yr)]] <- df_year
  }
  return(yearly_list)
}

