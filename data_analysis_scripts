process_province_data <- function(data) {
  # Step 2: Province-Level Summary
  province_profile <- data %>%
    group_by(province) %>%
    summarise(
      frequency_pub_ID = n_distinct(pub_ID),   # Unique publications
      frequency_virus_studied = n_distinct(virus), # Unique virus groups studied
      frequency_virus_detected = n_distinct(virus[positive_sample > 0]),
      sample_number = sum(sample_size, na.rm = TRUE),
      total_positive = sum(positive_sample, na.rm = TRUE),
      average_prevalence = ifelse(sample_number > 0, total_positive / sample_number, NA),
      min_sampling_year = min(sampling_year, na.rm = TRUE),  # Earliest year
      max_sampling_year = max(sampling_year, na.rm = TRUE),  # Newest year
      .groups = "drop"
    )
  
  # Step 3: Positive sample per Virus Group per Province
  virus_group_profile <- data %>%
    mutate(
      virus_group_mod = case_when(
        virus_group == "IAV" & grepl("H1N1", subtype_strain, ignore.case = TRUE) ~ "IAV_H1N1",
        virus_group == "PCV" & grepl("PCV2", virus, ignore.case = TRUE) ~ "PCV2",
        virus_group == "PCV" & grepl("PCV3", virus, ignore.case = TRUE) ~ "PCV3",
