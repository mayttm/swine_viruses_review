##-------- Odds ratio-----------##

for (dataset_name in dataset_names) {
  data <- get(dataset_name)
  required_cols <- c("pig_type", "positive_sample", "sample_size", "pub_ID", "sampling_year", "diag_test")
  if (!all(required_cols %in% colnames(data))) next
  
  data <- data %>%
    dplyr::filter(!is.na(pig_type), str_trim(pig_type) != "", sample_size >= 30)
  
  valid_pig_types <- data %>%
    dplyr::group_by(pig_type) %>%
    dplyr::summarise(n_pub = dplyr::n_distinct(pub_ID), total_sample = sum(sample_size), .groups = "drop") %>%
    dplyr::filter(n_pub > 1 & total_sample > 1) %>%
    dplyr::pull(pig_type)
  data <- data %>% dplyr::filter(pig_type %in% valid_pig_types)
  if (length(unique(data$pig_type)) < 2) next
  
  zero_event <- data %>%
    dplyr::group_by(pig_type) %>%
    dplyr::summarise(total_events = sum(positive_sample), .groups = "drop") %>%
    dplyr::filter(total_events == 0)
  if (nrow(zero_event) > 0) next
  
  # Reference = lowest crude prevalence
  ref_tbl <- data %>%
    dplyr::group_by(pig_type) %>%
    dplyr::summarise(pos = sum(positive_sample), n = sum(sample_size), prev = pos / n, .groups = "drop")
  ref_type <- ref_tbl$pig_type[which.min(ref_tbl$prev)]
  
  # Meta-regression on logit proportions
  dat_es <- metafor::escalc(measure = "PLO", xi = positive_sample, ni = sample_size, data = data)
  dat_es$pig_type <- stats::relevel(factor(dat_es$pig_type), ref = ref_type)
  fit <- metafor::rma(yi, vi, mods = ~ pig_type, method = "REML", data = dat_es)
  
  # Extract contrasts vs reference (do not include the reference as a plotted row)
  coefs <- stats::coef(fit)
  V <- stats::vcov(fit)
  levs <- levels(dat_es$pig_type)
  MM <- model.matrix(~ pig_type, data = dat_es)
  mm_cols <- colnames(MM)
  get_cname_for_level <- function(level) {
    idx_rows <- which(dat_es$pig_type == level)
    if (length(idx_rows) == 0) return(NA_character_)
    mm_noint <- MM[idx_rows, mm_cols != "(Intercept)", drop = FALSE]
    col_hit <- colnames(mm_noint)[which(colSums(mm_noint) > 0)]
    if (length(col_hit) != 1) return(NA_character_)
    if (!(col_hit %in% names(coefs))) return(NA_character_)
    col_hit
  }
  
  res_list <- lapply(levs, function(lv) {
    if (lv == ref_type) {
      # keep for completeness but will drop via SE = NA
      data.frame(pig_type = lv, logOR = 0, SE = NA_real_, OR = 1,
                 ci.lb = NA_real_, ci.ub = NA_real_, stringsAsFactors = FALSE)
    } else {
      cname <- get_cname_for_level(lv)
      if (is.na(cname)) return(NULL)
      logOR <- unname(coefs[cname])
      SE <- sqrt(V[cname, cname])
      data.frame(pig_type = lv, logOR = logOR, SE = SE,
                 OR = exp(logOR),
                 ci.lb = exp(logOR - 1.96 * SE),
                 ci.ub = exp(logOR + 1.96 * SE),
                 stringsAsFactors = FALSE)
    }
  })
  res <- do.call(rbind, res_list)
  if (is.null(res) || nrow(res) == 0) next
  
  # Drop the reference row (SE is NA there), and order
  df_plot <- res %>% dplyr::filter(!is.na(SE)) %>% dplyr::arrange(OR)
  if (nrow(df_plot) == 0) next
  
  # Meta object for plotting (random effects to carry heterogeneity stats if needed)
  meta_res <- meta::metagen(
    TE = df_plot$logOR,
    seTE = df_plot$SE,
    studlab = df_plot$pig_type,
    sm = "OR",
    comb.fixed = FALSE,
    comb.random = TRUE,
    prediction = FALSE
  )
  
  # Sizing
  n_levels <- nrow(df_plot)
  png_width <- 4000
  png_height <- max(2800, n_levels * 120)
  cex_value <- min(0.95, 900 / (n_levels + 4) + 0.25)
  # wider left margin if labels are long
  max_lab_nchar <- max(nchar(as.character(df_plot$pig_type)))
  mar_left <- max(6, min(16, 6 + 0.08 * max_lab_nchar))
  
  # Export PNG (reference is NOT plotted)
  export_path <- "figures/or_pig_type/odds_ratios/"
  dir.create(export_path, recursive = TRUE, showWarnings = FALSE)
  png_filename <- paste0(export_path, dataset_name, "_OR_vs_", ref_type, ".png")
  png(filename = png_filename, width = png_width, height = png_height, res = 300)
  par(mar = c(3, mar_left, 4, 2))
  meta::forest(
    meta_res,
    leftcols  = c("studlab"),
    leftlabs  = c("Pig type"),
    rightcols = c("effect","ci","pval"),
    rightlabs = c("OR","95% CI","p value"),
    smlab = paste0("OR vs ", ref_type),
    backtransf = TRUE,
    overall = FALSE,
    comb.random = TRUE,
    print.tau2 = TRUE,
    print.I2   = TRUE,
    print.pval.Q = TRUE,
    col.square = "darkblue",
    col.diamond.lines = "black",
    sortvar = seq_along(meta_res$TE),
    xlab = "OR",
    just = "center",
    colgap.forest.left = "6cm",
    colgap.forest.right = "1cm",
    cex = cex_value,
    spacing = 1.15
  )
  dev.off()
}

