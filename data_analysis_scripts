library(tidyverse)
library(sf)
library(ggplot2)
library(viridis)
library(patchwork)

create_province_profile <- function(data) {
  total_pub_ID <- n_distinct(data$pub_ID)
  province_profile <- data %>%
    group_by(province) %>%
    summarise(
      frequency_pub_ID = n_distinct(pub_ID),   # Unique publications per province
      sample_number = sum(sample_size, na.rm = TRUE),
      total_positive = sum(positive_sample, na.rm = TRUE),
      average_prevalence = ifelse(sample_number > 0, total_positive / sample_number, NA),
      min_sampling_year = min(sampling_year, na.rm = TRUE),  
      max_sampling_year = max(sampling_year, na.rm = TRUE),  
      total_pub_ID = total_pub_ID,  # Same value repeated for each province
      .groups = "drop"
    )
  
  return(province_profile)
}

